---
import { home } from '../../data/home';
---

<section class="about" id="about" data-about>
	<div class="about__inner">
		<p class="about__eyebrow" data-about-item><span>01</span> Sobre PulsoWeb</p>
		<h2 data-about-item>Desarrollamos soluciones web para impulsar tu <em>negocio.</em></h2>
		<p class="about__intro" data-about-item>{home.quote}</p>

		<div class="about__story" data-about-item>
			<p>{home.paragraphs[0]}</p>
			<p>{home.paragraphs[1]}</p>
		</div>

		<div class="about__stats" aria-label="Cifras de PulsoWeb">
			{home.stats.map((stat) => (
				<article data-about-stat data-value={stat.value} data-suffix={stat.suffix}>
					<strong>{stat.value}{stat.suffix}</strong>
					<span>{stat.label}</span>
				</article>
			))}
		</div>

	</div>
</section>

<style>
	.about { position: relative; overflow: hidden; background: var(--color-white); color: var(--ink); }
	.about__inner { position: relative; width: min(1360px,calc(100% - 48px)); margin: auto; padding: clamp(6.5rem,11vw,11rem) 0; text-align: left; }
	.about__eyebrow { display: inline-flex; gap: 10px; margin: 0 0 28px; align-items: center; color: var(--color-brand-deep); font-size: .7rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
	.about__eyebrow span { display: grid; width: 28px; height: 28px; place-items: center; border: 1px solid rgba(var(--color-brand-rgb),.3); border-radius: 50%; font-size: .58rem; }
	.about h2 { width: 100%; margin: 0; color: var(--ink); font-size: clamp(2.65rem,6vw,6.4rem); font-weight: 700; letter-spacing: -.065em; line-height: .98; }
	.about h2 em { color: var(--color-brand-deep); font-style: normal; font-weight: 700; }
	.about__intro { width: 100%; margin: 34px 0 0; color: #30495b; font-size: clamp(1.1rem,2vw,1.55rem); font-weight: 500; line-height: 1.55; }
	.about__story { display: grid; width: 100%; gap: 20px clamp(3rem,8vw,8rem); margin: clamp(3rem,6vw,5rem) 0 0; padding-top: 42px; border-top: 1px solid rgba(7,19,31,.11); }
	.about__story p { width: 100%; margin: 0; color: #617483; font-size: .98rem; line-height: 1.8; }
	.about__stats { display: grid; width: 100%; margin: clamp(3.5rem,7vw,6rem) 0 0; grid-template-columns: repeat(3,1fr); border: 1px solid rgba(7,19,31,.09); border-radius: 22px; background: #fff; box-shadow: 0 24px 70px rgba(18,56,78,.08); }
	.about__stats article { position: relative; padding: clamp(1.8rem,4vw,3.2rem) 18px; }
	.about__stats article + article::before { position: absolute; top: 22%; bottom: 22%; left: 0; width: 1px; background: rgba(7,19,31,.1); content: ''; }
	.about__stats strong { display: block; color: var(--color-brand-deep); font-size: clamp(2.7rem,5vw,5.2rem); font-weight: 800; letter-spacing: -.06em; line-height: 1; }
	.about__stats span { display: block; margin-top: 12px; color: #617483; font-size: .65rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
	@media(min-width:760px) { .about__story { grid-template-columns: repeat(2,1fr); } }
	@media(max-width:620px) { .about__inner { width: min(100% - 28px,1360px); }.about__stats { grid-template-columns: 1fr; }.about__stats article + article::before { top: 0; right: 12%; bottom: auto; left: 12%; width: auto; height: 1px; } }
</style>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	gsap.registerPlugin(ScrollTrigger);
	const section = document.querySelector<HTMLElement>('[data-about]');
	if (section && !section.dataset.ready && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		section.dataset.ready = 'true';
		const context = gsap.context(() => {
			gsap.from('[data-about-item]', { y: 28, autoAlpha: 0, duration: .65, stagger: .1, ease: 'power3.out', scrollTrigger: { trigger: section, start: 'top 76%', once: true } });
			const stats = [...section.querySelectorAll<HTMLElement>('[data-about-stat]')];
			gsap.from(stats, { y: 24, autoAlpha: 0, duration: .55, stagger: .1, ease: 'power3.out', scrollTrigger: { trigger: '.about__stats', start: 'top 84%', once: true, onEnter: () => stats.forEach((stat) => {
				const number = stat.querySelector('strong'); const target = Number(stat.dataset.value); const suffix = stat.dataset.suffix ?? '';
				gsap.fromTo({ value: 0 }, { value: 0 }, { value: target, duration: 1.25, ease: 'power3.out', onUpdate() { if (number) number.textContent = `${Math.round(this.targets()[0].value)}${suffix}`; } });
			}) } });
		}, section);
		window.addEventListener('pagehide', () => context.revert(), { once: true });
	}
</script>
