---
import { contactEmail, whatsappDisplay, whatsappLinks } from '../../data/site';
---

<section class="contact-section" id="contacto" aria-labelledby="contact-title">
	<div class="container contact-shell" data-reveal="scale">
		<div class="contact-copy">
			<p class="eyebrow">Hablemos de tu proyecto</p>
			<h2 id="contact-title">Cuéntanos qué necesitas construir.</h2>
			<p>Escríbenos con una idea general de tu negocio y te orientaremos sobre el mejor punto de partida.</p>
			<a class="contact-primary" href={whatsappLinks.general} target="_blank" rel="noopener noreferrer">Conversar por WhatsApp <span>↗</span></a>
		</div>

		<div class="contact-options">
			<a href={whatsappLinks.general} target="_blank" rel="noopener noreferrer">
				<span class="contact-icon contact-icon--whatsapp" aria-hidden="true">
					<svg viewBox="0 0 24 24"><path d="M20 11.5a8 8 0 0 1-8.5 8L5 21l1.5-5.4A8 8 0 1 1 20 11.5Z" /><path d="M9 11.5h.01M12 11.5h.01M15 11.5h.01" /></svg>
				</span>
				<span><small>WhatsApp</small><strong>{whatsappDisplay}</strong><em>Respuesta directa</em></span><i>↗</i>
			</a>
			<a href={`mailto:${contactEmail}`}>
				<span class="contact-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24"><path d="M3 6h18v12H3z" /><path d="m4 7 8 6 8-6" /></svg>
				</span>
				<span><small>Correo</small><strong>{contactEmail}</strong><em>Consultas y propuestas</em></span><i>↗</i>
			</a>
			<div class="contact-location">
				<span class="contact-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></svg>
				</span>
				<span><small>Ubicación</small><strong>Chile</strong><em>Atención remota</em></span>
			</div>
		</div>
	</div>
</section>

<style>
	.contact-section { padding: var(--section-space) 0; }
	.contact-shell { display: grid; padding: clamp(32px,6vw,70px); grid-template-columns: minmax(0,1fr) minmax(340px,.7fr); gap: clamp(50px,8vw,110px); overflow: hidden; border: 1px solid rgba(148,163,184,.16); border-radius: 28px; background: radial-gradient(circle at 20% 20%,rgba(var(--color-brand-rgb),.15),transparent 38%),linear-gradient(145deg,#10243d,#0a1728); }
	.contact-copy h2 { max-width: 700px; font-size: clamp(2.4rem,5vw,4.6rem); }
	.contact-copy > p:not(.eyebrow) { max-width: 600px; margin: 25px 0 0; color: #94a6bb; font-size: .93rem; line-height: 1.75; }
	.contact-primary { display: inline-flex; min-height: 51px; margin-top: 32px; padding: 0 20px; align-items: center; gap: 26px; border-radius: 12px; background: linear-gradient(120deg,var(--color-brand-deep),var(--color-brand)); color: #fff; font-size: .74rem; font-weight: 800; transition: transform .18s ease,box-shadow .18s ease; }
	.contact-primary:hover { box-shadow: 0 15px 35px rgba(var(--color-brand-rgb),.24); transform: translateY(-2px); }
	.contact-options { display: grid; gap: 10px; }
	.contact-options > a,.contact-location { display: flex; min-width: 0; padding: 16px; align-items: center; gap: 13px; border: 1px solid rgba(148,163,184,.13); border-radius: 14px; background: rgba(7,17,31,.42); }
	.contact-options > a { transition: border-color .18s ease,background .18s ease; }
	.contact-options > a:hover { border-color: rgba(var(--color-brand-rgb),.28); background: rgba(12,29,49,.72); }
	.contact-icon { display: grid; flex: 0 0 40px; height: 40px; place-items: center; border-radius: 11px; background: rgba(var(--color-brand-rgb),.08); color: var(--color-sky); }
	.contact-icon--whatsapp { background: rgba(52,211,153,.09); color: #6ee7b7; }
	.contact-icon svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
	.contact-options > a > span:nth-child(2),.contact-location > span:nth-child(2) { min-width: 0; }
	.contact-options small,.contact-options strong,.contact-options em { display: block; }
	.contact-options small { margin-bottom: 3px; color: #66788f; font-size: .49rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
	.contact-options strong { overflow-wrap: anywhere; color: #d9e4f1; font-size: .7rem; }
	.contact-options em { margin-top: 3px; color: #718299; font-size: .53rem; font-style: normal; }
	.contact-options > a > i { margin-left: auto; color: var(--color-sky); font-size: .8rem; font-style: normal; }
	@media(max-width:850px){
		.contact-shell { grid-template-columns: 1fr; }
	}
	@media(max-width:520px){
		.contact-shell { padding: 30px 20px; border-radius: 22px; }
		.contact-primary { width: 100%; justify-content: space-between; }
	}
</style>
