---
import { home } from '../../data/home';

const questions = [
	{ question: '¿Qué necesito para comenzar?', answer: 'Una idea general de tu negocio, tus servicios o productos y el objetivo del proyecto. Si aún no tienes todo definido, lo ordenamos contigo durante la primera conversación.' },
	{ question: '¿Cuánto demora un proyecto?', answer: 'Depende del alcance, la cantidad de contenido y la rapidez de las revisiones. El plazo estimado queda definido en la propuesta antes de comenzar.' },
	{ question: '¿El dominio y la publicación están incluidos?', answer: 'Pueden formar parte de la propuesta cuando corresponda. Dejamos por escrito qué incluye la implementación y qué servicios requieren renovación.' },
	{ question: '¿Cómo se realizan los pagos?', answer: 'La modalidad y los hitos de pago se indican en cada propuesta según el tamaño del proyecto. Las condiciones quedan claras antes de comenzar.' },
	{ question: '¿Podré administrar mi sitio o tienda?', answer: 'Sí. Definimos el nivel de administración según tus necesidades y, en ecommerce, incluimos orientación básica para gestionar productos y pedidos.' },
	{ question: '¿Ofrecen soporte después de publicar?', answer: 'Sí. Podemos acompañarte con mantención, respaldos, seguridad y soporte técnico mediante un servicio acorde a tu sitio.' },
];
---

<section class="faq" id="faq" data-faq aria-labelledby="faq-title">
	<div class="faq__inner">
		<header class="faq__heading">
			<p><span>05</span> Preguntas frecuentes</p>
			<h2 id="faq-title">Antes de empezar,<br /><em>resolvamos tus dudas.</em></h2>
			<div class="faq__help">
				<p>¿No encuentras tu pregunta? Cuéntanos tu idea y revisamos tu caso sin compromiso.</p>
				<a href={home.links.contact} target="_blank" rel="noopener noreferrer">Hacer una pregunta <span>↗</span></a>
			</div>
		</header>

		<div class="faq__list">
			{questions.map((item, index) => (
				<article class="faq__item" data-faq-item>
					<h3><button type="button" aria-expanded="false" aria-controls={`faq-${index + 1}`} data-faq-trigger>
						<small>0{index + 1}</small><span>{item.question}</span><i aria-hidden="true"><b></b><b></b></i>
					</button></h3>
					<div class="faq__panel" id={`faq-${index + 1}`} data-faq-panel><p>{item.answer}</p></div>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.faq { border-top: 1px solid rgba(10,10,10,.09); background: #fff; color: var(--ink); }
	.faq__inner { display: grid; width: min(1360px,calc(100% - 48px)); gap: clamp(3rem,7vw,7rem); margin: auto; padding: clamp(6.5rem,10vw,10rem) 0; }
	.faq__heading > p:first-child { display: flex; gap: 10px; margin: 0 0 24px; align-items: center; color: var(--color-brand-deep); font-size: .7rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
	.faq__heading > p:first-child span { display: grid; width: 28px; height: 28px; place-items: center; border: 1px solid rgba(var(--color-brand-rgb),.35); border-radius: 50%; font-size: .58rem; }
	.faq h2 { color: var(--ink); font-size: clamp(2.7rem,5.2vw,5.8rem); font-weight: 700; letter-spacing: -.06em; line-height: .98; }
	.faq h2 em { color: var(--color-brand-deep); font-style: normal; }
	.faq__help { max-width: 410px; margin-top: 34px; }
	.faq__help p { margin: 0; color: #617483; font-size: .92rem; line-height: 1.7; }
	.faq__help a { display: inline-flex; gap: 18px; margin-top: 20px; align-items: center; color: var(--ink); font-size: .67rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
	.faq__help a span { color: var(--color-brand-deep); font-size: 1rem; }
	.faq__list { display: grid; gap: 10px; align-content: start; }
	.faq__item { overflow: hidden; border: 1px solid rgba(7,19,31,.09); border-radius: 16px; background: rgba(255,255,255,.8); transition: border-color .25s ease,background .25s ease; }
	.faq__item.is-open { border-color: rgba(var(--color-brand-rgb),.38); background: #fff; }
	.faq h3 { margin: 0; }
	.faq button { display: grid; width: 100%; min-height: 82px; padding: 16px 18px; align-items: center; grid-template-columns: 34px minmax(0,1fr) 38px; gap: 12px; border: 0; background: transparent; color: var(--ink); cursor: pointer; text-align: left; }
	.faq button small { color: var(--color-brand-deep); font-size: .62rem; font-weight: 800; letter-spacing: .08em; }
	.faq button > span { font-size: clamp(.98rem,1.5vw,1.16rem); font-weight: 700; letter-spacing: -.02em; line-height: 1.35; }
	.faq button > i { position: relative; display: block; width: 38px; height: 38px; border: 1px solid rgba(7,19,31,.11); border-radius: 11px; background: rgba(var(--color-brand-rgb),.06); }
	.faq button > i b { position: absolute; top: 50%; left: 12px; width: 12px; height: 1px; background: var(--color-brand-deep); transition: transform .25s var(--ease-out-expo); }
	.faq button > i b:last-child { transform: rotate(90deg); }
	.faq__item.is-open button > i b:last-child { transform: rotate(0); }
	.faq__panel { height: 0; overflow: hidden; opacity: 0; }
	.faq__panel p { max-width: 680px; margin: 0; padding: 0 68px 26px 64px; color: #617483; font-size: .9rem; line-height: 1.75; }
	@media(min-width:900px) { .faq__inner { grid-template-columns: minmax(330px,.7fr) minmax(480px,1fr); }.faq__heading { position: sticky; top: 110px; align-self: start; } }
	@media(max-width:700px) { .faq__inner { width: min(100% - 28px,1360px); }.faq button { min-height: 74px; padding-inline: 14px; grid-template-columns: 26px minmax(0,1fr) 36px; }.faq__panel p { padding: 0 20px 24px 52px; } }
</style>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	gsap.registerPlugin(ScrollTrigger);
	const faq = document.querySelector<HTMLElement>('[data-faq]');
	if (faq && !faq.dataset.ready) {
		faq.dataset.ready = 'true';
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const items = [...faq.querySelectorAll<HTMLElement>('[data-faq-item]')];
		const close = (item: HTMLElement) => {
			item.classList.remove('is-open');
			item.querySelector<HTMLButtonElement>('[data-faq-trigger]')?.setAttribute('aria-expanded', 'false');
			const panel = item.querySelector<HTMLElement>('[data-faq-panel]');
			if (panel) gsap.to(panel, { height: 0, autoAlpha: 0, duration: reducedMotion ? 0 : .3, ease: 'power2.out', overwrite: true });
		};
		const listeners = items.map((item) => {
			const trigger = item.querySelector<HTMLButtonElement>('[data-faq-trigger]');
			const handler = () => {
				const opening = !item.classList.contains('is-open');
				items.forEach(close);
				if (opening) {
					item.classList.add('is-open'); trigger?.setAttribute('aria-expanded', 'true');
					const panel = item.querySelector<HTMLElement>('[data-faq-panel]');
					if (panel) gsap.to(panel, { height: 'auto', autoAlpha: 1, duration: reducedMotion ? 0 : .35, ease: 'power3.out', overwrite: true });
				}
			};
			trigger?.addEventListener('click', handler); return { trigger, handler };
		});
		const context = gsap.context(() => { if (!reducedMotion) gsap.from('[data-faq-item]', { y: 20, autoAlpha: 0, duration: .5, stagger: .06, ease: 'power3.out', scrollTrigger: { trigger: '.faq__list', start: 'top 84%', once: true } }); }, faq);
		window.addEventListener('pagehide', () => { listeners.forEach(({ trigger, handler }) => trigger?.removeEventListener('click', handler)); context.revert(); }, { once: true });
	}
</script>
