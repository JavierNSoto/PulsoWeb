---
const steps = [
	{ key: 'strategy', title: 'Estrategia', description: 'Definimos objetivos, alcance y prioridades.' },
	{ key: 'design', title: 'Diseño', description: 'Creamos la estructura y la experiencia visual.' },
	{ key: 'development', title: 'Desarrollo', description: 'Construimos, optimizamos y probamos tu sitio.' },
	{ key: 'launch', title: 'Lanzamiento', description: 'Publicamos y acompañamos la puesta en marcha.' },
];
---

<section class="process-section" id="proceso" aria-labelledby="process-title">
	<div class="container">
		<header class="process-heading" data-reveal="up">
			<p class="eyebrow">Cómo trabajamos</p>
			<h2 id="process-title">Cuatro pasos. <span>Un resultado claro.</span></h2>
			<p>Un proceso simple y ordenado para llevar tu idea a una web lista para crecer.</p>
		</header>

		<ol class="process-steps" data-stagger>
			{steps.map((step, index) => (
				<li>
					<div class="step-top">
						<span class="step-icon" aria-hidden="true">
							{step.key === 'strategy' && <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" /><circle cx="12" cy="12" r="3" /><path d="M12 2v3M22 12h-3" /></svg>}
							{step.key === 'design' && <svg viewBox="0 0 24 24"><path d="m4 16 9-9 4 4-9 9H4v-4Z" /><path d="m14 6 2-2 4 4-2 2" /></svg>}
							{step.key === 'development' && <svg viewBox="0 0 24 24"><path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 5l-4 14" /></svg>}
							{step.key === 'launch' && <svg viewBox="0 0 24 24"><path d="M14 4c3-1 5 0 6 0 0 1 1 3 0 6l-5 5-5-5 4-6Z" /><path d="m10 14-3 1-2 4 4-2 1-3ZM14 10l-7 7" /></svg>}
						</span>
						<span class="step-number">0{index + 1}</span>
					</div>
					<h3>{step.title}</h3>
					<p>{step.description}</p>
				</li>
			))}
		</ol>
	</div>
</section>

<style>
	.process-section { padding: var(--section-space) 0; }
	.process-heading { display: grid; grid-template-columns: minmax(0,1.2fr) minmax(280px,.6fr); gap: 20px clamp(40px,8vw,105px); align-items: end; }
	.process-heading .eyebrow { grid-column: 1 / -1; margin-bottom: 0; }
	.process-heading h2 { max-width: 720px; font-size: clamp(2.5rem,5vw,4.6rem); }
	.process-heading h2 span { color: var(--color-brand); }
	.process-heading > p:last-child { max-width: 390px; margin: 0 0 8px; color: var(--color-muted); font-size: .92rem; line-height: 1.7; }
	.process-steps { position: relative; display: grid; margin: 60px 0 0; padding: 0; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 14px; list-style: none; }
	.process-steps li { position: relative; min-width: 0; padding: 25px 24px 27px; border: 1px solid rgba(var(--color-brand-rgb),.12); border-radius: 18px; background: #0b192b; transition: border-color .22s ease,transform .22s ease,box-shadow .22s ease; }
	.process-steps li:not(:last-child)::after { position: absolute; top: 44px; left: 100%; z-index: 2; width: 15px; height: 1px; background: linear-gradient(90deg,rgba(var(--color-brand-rgb),.55),rgba(var(--color-brand-rgb),.16)); content: ''; }
	.process-steps li:hover { border-color: rgba(var(--color-brand-rgb),.34); box-shadow: 0 20px 50px rgba(0,0,0,.2); transform: translateY(-4px); }
	.step-top { display: flex; align-items: center; justify-content: space-between; }
	.step-icon { display: grid; width: 42px; height: 42px; place-items: center; border: 1px solid rgba(var(--color-brand-rgb),.23); border-radius: 12px; background: rgba(var(--color-brand-rgb),.08); color: var(--color-sky); }
	.step-icon svg { width: 21px; height: 21px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
	.step-number { color: #53657b; font-size: .62rem; font-weight: 800; letter-spacing: .14em; }
	.process-steps h3 { margin: 26px 0 10px; color: #e6edf6; font-size: 1.06rem; font-weight: 800; letter-spacing: -.025em; }
	.process-steps p { margin: 0; color: #8091a7; font-size: .72rem; line-height: 1.65; }
	@media(max-width:900px){
		.process-heading { grid-template-columns: 1fr; gap: 24px; }
		.process-heading .eyebrow { grid-column: auto; }
		.process-heading > p:last-child { margin: 0; }
		.process-steps { grid-template-columns: repeat(2,minmax(0,1fr)); }
		.process-steps li::after { display: none; }
	}
	@media(max-width:560px){
		.process-steps { margin-top: 44px; grid-template-columns: 1fr; }
		.process-steps li { padding: 22px; }
		.process-steps h3 { margin-top: 20px; }
	}
	@media(prefers-reduced-motion:reduce){
		.process-steps li:hover { transform: none; }
	}
</style>
