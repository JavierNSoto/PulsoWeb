---
import { whatsappLinks } from '../../data/site';
import { webPlans } from '../../data/webPlans';
---

<section class="web-solutions" id="paginas-web" aria-labelledby="web-solutions-title">
	<div class="container">
		<header class="solutions-heading" data-reveal="up">
			<div>
				<p class="eyebrow">Diseño web profesional</p>
				<h2 id="web-solutions-title">La web que tu negocio necesita para avanzar.</h2>
			</div>
			<p>Creamos sitios corporativos y tiendas online alineados con tus objetivos, tu marca y la forma en que tus clientes toman decisiones.</p>
		</header>

		<div class="solutions-list">
			{webPlans.map((plan, index) => (
				<article class:list={['solution-card', { 'solution-card--reverse': index === 1 }]} data-reveal={index === 0 ? 'left' : 'right'}>
					<div class="solution-visual" aria-hidden="true">
						<div class="visual-meta">
							<span>0{index + 1}</span>
							<small>{index === 0 ? 'Presencia que conecta' : 'Una tienda siempre abierta'}</small>
						</div>

						{index === 0 ? (
							<div class="browser-mockup">
								<div class="mockup-toolbar">
									<div class="toolbar-dots"><i></i><i></i><i></i></div>
									<span>tumarca.cl</span>
								</div>
								<div class="website-preview">
									<div class="preview-nav"><b></b><span></span><span></span><span></span></div>
									<div class="preview-hero">
										<div><small></small><strong></strong><strong></strong><p></p><em></em></div>
										<div class="preview-photo"><span>✦</span></div>
									</div>
									<div class="preview-cards"><i></i><i></i><i></i></div>
								</div>
								<div class="mockup-badge mockup-badge--online"><i></i><span><b>Tu sitio online</b><small>Rápido y responsive</small></span></div>
							</div>
						) : (
							<div class="browser-mockup store-mockup">
								<div class="mockup-toolbar">
									<div class="toolbar-dots"><i></i><i></i><i></i></div>
									<span>tutienda.cl</span>
								</div>
								<div class="store-preview">
									<div class="store-nav"><b>SHOP</b><span></span><span></span><i>2</i></div>
									<div class="product-grid">
										<div class="product"><i></i><b></b><span></span></div>
										<div class="product"><i></i><b></b><span></span></div>
										<div class="product"><i></i><b></b><span></span></div>
									</div>
								</div>
								<div class="mockup-badge mockup-badge--sale">
									<span class="sale-icon">✓</span>
									<span><b>Nueva venta</b><small>Pedido confirmado</small></span>
								</div>
							</div>
						)}
					</div>

					<div class="solution-content">
						<p class="solution-type">{plan.type}</p>
						<h3>{plan.name}</h3>
						<p class="solution-description">{plan.description}</p>

						<div class="solution-features">
							<h4>{plan.featuresTitle}</h4>
							<ul>
								{plan.features.map((feature) => <li><i>✓</i><span>{feature}</span></li>)}
							</ul>
						</div>

						<a class="solution-cta" href={index === 0 ? whatsappLinks.website : whatsappLinks.ecommerce} target="_blank" rel="noopener noreferrer">
							<span>{plan.cta}</span><i>↗</i>
						</a>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.web-solutions { position: relative; overflow: hidden; padding: var(--section-space) 0; scroll-margin-top: 100px; }
	.web-solutions::before { position: absolute; top: 12%; left: -280px; width: 560px; height: 560px; border-radius: 50%; background: radial-gradient(circle,rgba(var(--color-brand-rgb),.09),transparent 68%); content: ''; pointer-events: none; }
	.solutions-heading { display: grid; grid-template-columns: minmax(0,1.25fr) minmax(280px,.65fr); gap: clamp(40px,8vw,110px); align-items: end; }
	.solutions-heading h2 { max-width: 760px; }
	.solutions-heading > p { margin: 0 0 7px; color: var(--color-muted); font-size: 1rem; line-height: 1.75; }

	.solutions-list { display: grid; gap: 22px; margin-top: 68px; }
	.solution-card { --accent-rgb: var(--color-brand-rgb); position: relative; display: grid; min-height: 520px; grid-template-columns: minmax(350px,.85fr) minmax(0,1.15fr); overflow: hidden; border: 1px solid rgba(148,163,184,.15); border-radius: 30px; background: linear-gradient(145deg,rgba(16,34,56,.98),rgba(7,18,32,.98)); box-shadow: 0 28px 80px rgba(0,0,0,.18); }
	.solution-card::before { position: absolute; top: -180px; right: -120px; width: 430px; height: 430px; border-radius: 50%; background: radial-gradient(circle,rgba(var(--accent-rgb),.12),transparent 68%); content: ''; pointer-events: none; }

	.solution-visual { position: relative; display: flex; min-width: 0; padding: clamp(30px,4vw,50px); align-items: center; justify-content: center; border-right: 1px solid rgba(148,163,184,.11); background: linear-gradient(145deg,rgba(var(--accent-rgb),.09),rgba(7,17,31,.25)); }
	.solution-card--reverse .solution-visual { order: 2; border-right: 0; border-left: 1px solid rgba(148,163,184,.11); }
	.visual-meta { position: absolute; top: 27px; right: 30px; left: 30px; display: flex; align-items: center; justify-content: space-between; }
	.visual-meta span { color: rgba(var(--accent-rgb),.78); font-size: .66rem; font-weight: 800; letter-spacing: .16em; }
	.visual-meta small { color: #607187; font-size: .57rem; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }

	.browser-mockup { position: relative; width: min(100%,390px); margin-top: 24px; border: 1px solid rgba(148,163,184,.23); border-radius: 15px; background: #0a1728; box-shadow: 0 30px 65px rgba(0,0,0,.34),0 0 0 7px rgba(var(--accent-rgb),.025); transform: perspective(900px) rotateY(3deg) rotateX(1deg); transition: transform .35s ease,box-shadow .35s ease; }
	.solution-card:hover .browser-mockup { box-shadow: 0 36px 75px rgba(0,0,0,.4),0 0 0 7px rgba(var(--accent-rgb),.045); transform: perspective(900px) rotateY(0) rotateX(0) translateY(-4px); }
	.mockup-toolbar { display: flex; height: 31px; padding: 0 11px; align-items: center; border-bottom: 1px solid rgba(148,163,184,.12); }
	.toolbar-dots { display: flex; gap: 4px; }
	.toolbar-dots i { width: 5px; height: 5px; border-radius: 50%; background: #405169; }
	.toolbar-dots i:first-child { background: rgb(var(--accent-rgb)); }
	.mockup-toolbar > span { position: absolute; left: 50%; color: #5d6e84; font-size: .45rem; font-weight: 600; transform: translateX(-50%); }
	.website-preview { padding: 17px; }
	.preview-nav { display: flex; height: 15px; align-items: center; justify-content: flex-end; gap: 10px; }
	.preview-nav b { width: 31px; height: 7px; margin-right: auto; border-radius: 4px; background: rgba(var(--accent-rgb),.6); }
	.preview-nav span { width: 19px; height: 3px; border-radius: 3px; background: #304057; }
	.preview-hero { display: grid; min-height: 150px; padding: 27px 9px 20px; grid-template-columns: 1.1fr .9fr; gap: 18px; align-items: center; }
	.preview-hero small,.preview-hero strong,.preview-hero p,.preview-hero em { display: block; border: 0; border-radius: 5px; }
	.preview-hero small { width: 44px; height: 4px; margin-bottom: 10px; background: rgba(var(--accent-rgb),.7); }
	.preview-hero strong { width: 95%; height: 9px; margin-bottom: 6px; background: #718198; }
	.preview-hero strong:nth-child(3) { width: 70%; }
	.preview-hero p { width: 82%; height: 4px; margin: 14px 0 16px; background: #2c3d54; }
	.preview-hero em { width: 51px; height: 15px; background: linear-gradient(120deg,var(--color-brand-deep),var(--color-brand)); }
	.preview-photo { display: grid; height: 112px; place-items: center; border: 1px solid rgba(var(--accent-rgb),.16); border-radius: 13px; background: radial-gradient(circle at 65% 35%,rgba(var(--accent-rgb),.35),transparent 26%),linear-gradient(145deg,#162d48,#0d1b2e); color: rgba(var(--accent-rgb),.85); }
	.preview-photo span { font-size: 1.3rem; }
	.preview-cards { display: grid; grid-template-columns: repeat(3,1fr); gap: 7px; }
	.preview-cards i { height: 38px; border: 1px solid rgba(148,163,184,.1); border-radius: 7px; background: rgba(148,163,184,.035); }

	.mockup-badge { position: absolute; display: flex; min-width: 145px; padding: 10px 12px; align-items: center; gap: 9px; border: 1px solid rgba(148,163,184,.2); border-radius: 11px; background: #101f33; box-shadow: 0 16px 35px rgba(0,0,0,.3); }
	.mockup-badge--online { right: -18px; bottom: -20px; }
	.mockup-badge--online > i { width: 8px; height: 8px; border-radius: 50%; background: #34d399; box-shadow: 0 0 0 4px rgba(52,211,153,.1); }
	.mockup-badge span,.mockup-badge b,.mockup-badge small { display: block; }
	.mockup-badge b { margin-bottom: 3px; color: #dce6f3; font-size: .57rem; }
	.mockup-badge small { color: #71839a; font-size: .47rem; }

	.store-mockup { transform: perspective(900px) rotateY(-3deg) rotateX(1deg); }
	.store-preview { padding: 16px; }
	.store-nav { display: flex; height: 24px; align-items: center; gap: 10px; }
	.store-nav b { margin-right: auto; color: rgb(var(--accent-rgb)); font-size: .54rem; letter-spacing: .08em; }
	.store-nav span { width: 20px; height: 3px; border-radius: 4px; background: #34455c; }
	.store-nav i { display: grid; width: 17px; height: 17px; place-items: center; border-radius: 50%; background: rgba(var(--accent-rgb),.18); color: #ddd6fe; font-size: .43rem; font-style: normal; }
	.product-grid { display: grid; margin-top: 16px; grid-template-columns: repeat(3,1fr); gap: 8px; }
	.product { padding: 7px; border: 1px solid rgba(148,163,184,.1); border-radius: 9px; background: rgba(148,163,184,.025); }
	.product i { display: block; height: 91px; margin-bottom: 9px; border-radius: 7px; background: linear-gradient(145deg,rgba(var(--accent-rgb),.2),#14263c); }
	.product:nth-child(2) i { background: linear-gradient(145deg,rgba(var(--color-brand-rgb),.18),#15283c); }
	.product:nth-child(3) i { background: linear-gradient(145deg,rgba(52,211,153,.15),#14283b); }
	.product b,.product span { display: block; height: 4px; border-radius: 3px; }
	.product b { width: 76%; margin-bottom: 7px; background: #63748a; }
	.product span { width: 38%; background: rgba(var(--accent-rgb),.75); }
	.mockup-badge--sale { bottom: -20px; left: -18px; }
	.sale-icon { display: grid !important; width: 27px; height: 27px; place-items: center; border-radius: 8px; background: rgba(52,211,153,.13); color: #6ee7b7; font-size: .68rem; font-weight: 800; }

	.solution-content { position: relative; z-index: 1; display: flex; min-width: 0; padding: clamp(38px,5vw,64px); flex-direction: column; justify-content: center; }
	.solution-type { margin: 0 0 12px; color: rgb(var(--accent-rgb)); font-size: .65rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
	.solution-content h3 { margin: 0; font-size: clamp(2.2rem,4vw,3.6rem); font-weight: 800; letter-spacing: -.055em; line-height: 1; }
	.solution-description { max-width: 570px; margin: 18px 0 0; color: var(--color-muted); font-size: .9rem; line-height: 1.7; }
	.solution-features { margin-top: 28px; padding-top: 24px; border-top: 1px solid rgba(148,163,184,.11); }
	.solution-features h4 { margin: 0 0 15px; color: #c9d4e2; font-size: .66rem; font-weight: 700; }
	.solution-features ul { display: grid; margin: 0; padding: 0; grid-template-columns: repeat(2,minmax(0,1fr)); column-gap: 20px; list-style: none; }
	.solution-features li { display: flex; min-width: 0; padding: 5px 0; align-items: flex-start; gap: 8px; color: #8495aa; font-size: .67rem; line-height: 1.45; }
	.solution-features li i { display: grid; flex: 0 0 16px; height: 16px; margin-top: 1px; place-items: center; border-radius: 50%; background: rgba(var(--accent-rgb),.09); color: rgb(var(--accent-rgb)); font-size: .49rem; font-style: normal; font-weight: 800; }
	.solution-features li:last-child:nth-child(odd) { grid-column: 1 / -1; }
	.solution-cta { display: inline-flex; width: fit-content; min-height: 48px; margin-top: 28px; padding: 0 18px; align-items: center; gap: 28px; border: 1px solid rgba(var(--accent-rgb),.28); border-radius: 11px; background: rgba(var(--accent-rgb),.08); color: #fff; font-size: .72rem; font-weight: 800; transition: border-color .2s ease,background .2s ease,transform .2s ease; }
	.solution-cta:hover { border-color: rgba(var(--accent-rgb),.55); background: rgba(var(--accent-rgb),.15); transform: translateY(-2px); }
	.solution-cta i { color: rgb(var(--accent-rgb)); font-size: .95rem; font-style: normal; }

	@media(max-width:980px){
		.solution-card { grid-template-columns: minmax(300px,.8fr) minmax(0,1.2fr); }
		.solution-visual { padding: 30px; }
		.solution-content { padding: 38px; }
		.solution-features ul { grid-template-columns: 1fr; }
		.solution-features li:last-child:nth-child(odd) { grid-column: auto; }
	}
	@media(max-width:760px){
		.solutions-heading { grid-template-columns: 1fr; gap: 24px; }
		.solutions-heading > p { max-width: 620px; }
		.solution-card { grid-template-columns: 1fr; }
		.solution-visual,.solution-card--reverse .solution-visual { min-height: 410px; order: 0; border: 0; border-bottom: 1px solid rgba(148,163,184,.11); }
		.solution-content { padding: 38px 30px 40px; }
		.solution-features ul { grid-template-columns: repeat(2,minmax(0,1fr)); }
		.solution-features li:last-child:nth-child(odd) { grid-column: 1 / -1; }
	}
	@media(max-width:520px){
		.solutions-list { margin-top: 48px; }
		.solution-card { border-radius: 23px; }
		.solution-visual,.solution-card--reverse .solution-visual { min-height: 330px; padding: 25px; }
		.visual-meta { top: 20px; right: 20px; left: 20px; }
		.visual-meta small { display: none; }
		.browser-mockup { margin-top: 18px; transform: none; }
		.solution-card:hover .browser-mockup { transform: translateY(-3px); }
		.mockup-badge--online { right: -8px; }
		.mockup-badge--sale { left: -8px; }
		.solution-content { padding: 33px 22px 35px; }
		.solution-features ul { grid-template-columns: 1fr; }
		.solution-features li:last-child:nth-child(odd) { grid-column: auto; }
		.solution-cta { width: 100%; justify-content: space-between; }
		.product i { height: 70px; }
	}
	@media(prefers-reduced-motion:reduce){
		.browser-mockup,.solution-card:hover .browser-mockup { transform: none; transition: none; }
	}
</style>
