---
import { services } from '../../data/site';

const serviceItems = services.map((service, index) => ({
	id: `service-${index + 1}`,
	title: service.title,
	shortDescription: undefined,
	description: service.description,
	tags: undefined,
}));
const words = (value: string) => value.split(/\s+/);
---

<section class="services" id="services" data-services aria-labelledby="services-title">
	<div class="services__progress" aria-hidden="true"><i data-services-progress></i></div>
	<div class="services__inner">
		<header class="services__header"><p data-services-label>03 / SERVICIOS</p><i data-services-rule></i></header>
		<h2 id="services-title" data-services-title><span><b>Lo</b></span> <span><b>que</b></span> <span><em>Construimos</em></span></h2>
		<div class="services__list">
			{serviceItems.map((service, index) => (
				<article class="service" data-service>
					<h3><button type="button" aria-expanded="false" aria-controls={`${service.id}-panel`} data-service-trigger>
						<span class="service__number">{String(index + 1).padStart(2, '0')}</span>
						<span class="service__title-mask"><strong>{service.title}</strong></span>
						{service.shortDescription && <span class="service__short">{service.shortDescription}</span>}
						<span class="service__plus" aria-hidden="true"><i></i><i></i></span>
					</button></h3>
					<div class="service__panel" id={`${service.id}-panel`} data-service-panel>
						<div>
							{service.description && <p>{words(service.description).map((word) => <span data-service-word>{word}&nbsp;</span>)}</p>}
							{service.tags && service.tags.length > 0 && <ul>{service.tags.map((tag) => <li data-service-tag>{tag}</li>)}</ul>}
						</div>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.services { position: relative; overflow: clip; background: #0a0a0a; color: #fff; }.services__inner { width: min(1440px,100%); margin: auto; padding: clamp(5rem,10vw,11rem) clamp(1.25rem,5vw,5rem); }.services__header { display: flex; gap: 18px; align-items: center; }.services__header p { margin: 0; color: rgba(255,255,255,.25); font-size: 10px; font-weight: 600; letter-spacing: .22em; }.services__header i { height: 1px; flex: 1; background: rgba(255,255,255,.1); transform-origin: left; }.services h2 { margin: clamp(2.4rem,5vw,5rem) 0 0; color: #fff; font-size: clamp(2.8rem,7vw,8rem); font-weight: 900; letter-spacing: -.085em; line-height: .9; }.services h2 > span { display: inline-block; overflow: hidden; }.services h2 b,.services h2 em { display: block; font: inherit; }.services h2 em { color: rgba(255,255,255,.3); font-family: var(--font-editorial); font-weight: 400; }.services__progress { position: absolute; top: 0; bottom: 0; left: clamp(.65rem,2vw,2rem); display: none; width: 1px; background: rgba(255,255,255,.05); }.services__progress i { display: block; width: 1px; height: 100%; background: rgba(255,255,255,.2); transform-origin: top; }.services__list { margin-top: clamp(3rem,5vw,6rem); border-top: 1px solid rgba(255,255,255,.08); }.service { position: relative; border-bottom: 1px solid rgba(255,255,255,.08); transition: opacity .5s ease; }.service::before { position: absolute; top: 0; bottom: 0; left: 0; width: 1px; background: rgba(255,255,255,.3); content: ''; transform: scaleY(0); transform-origin: center; transition: transform .35s var(--ease-out-expo); }.service h3 { margin: 0; }.service button { display: grid; width: 100%; min-width: 0; padding: 24px 16px; align-items: center; grid-template-columns: 34px minmax(0,1fr) 28px; gap: 12px; border: 0; background: transparent; color: inherit; cursor: pointer; text-align: left; }.service__number { color: rgba(255,255,255,.22); font-size: 10px; font-weight: 600; letter-spacing: .2em; transition: color .3s ease; }.service__title-mask { overflow: hidden; }.service__title-mask strong { display: block; font-size: clamp(1.5rem,3.5vw,3.5rem); font-weight: 900; letter-spacing: -.035em; line-height: 1; }.service__short { display: none; }.service__plus { position: relative; display: block; width: 20px; height: 20px; }.service__plus i { position: absolute; top: 50%; left: 0; width: 20px; height: 1px; background: rgba(255,255,255,.5); transition: transform .3s var(--ease-out-expo); }.service__plus i:last-child { transform: rotate(90deg); }.service__panel { overflow: hidden; }.service__panel > div { padding: 0 calc(16px + 28px + 12px) 40px calc(16px + 34px + 12px); }.service__panel p { max-width: 672px; margin: 0; color: rgba(255,255,255,.5); font-size: clamp(.95rem,1.4vw,1.1rem); line-height: 1.75; }.service__panel p span { display: inline-block; }.service__panel ul { display: flex; flex-wrap: wrap; gap: 7px; margin: 22px 0 0; padding: 0; list-style: none; }.service__panel li { padding: 4px 10px; border: 1px solid rgba(255,255,255,.15); color: rgba(255,255,255,.35); font-size: 9px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }.services.has-js .service__panel { height: 0; opacity: 0; }.services.has-js .service.is-open .service__panel { opacity: 1; }.services.has-js .service.is-dim { opacity: .35; }.service.is-open .service__number,.service:hover .service__number { color: rgba(255,255,255,.75); }.service.is-open::before { transform: scaleY(1); }.service.is-open .service__plus i:first-child { transform: rotate(45deg); }.service.is-open .service__plus i:last-child { transform: rotate(-45deg); }
	@media(min-width:768px) { .service button { padding: 32px 24px; grid-template-columns: 52px minmax(0,1fr) minmax(180px,.55fr) 28px; gap: 20px; }.service__short { display: block; color: rgba(255,255,255,.35); font-size: clamp(14px,1.2vw,16px); line-height: 1.5; transition: opacity .3s ease; }.service.is-open .service__short { opacity: 0; }.service__panel > div { padding-left: calc(24px + 52px + 20px); padding-right: 72px; }.service:hover { background: linear-gradient(90deg,rgba(255,255,255,.04),transparent 60%); }.service:hover::before { transform: scaleY(1); }.service:hover button > :not(.service__number):not(.service__plus) { transform: translateX(10px); transition: transform .45s var(--ease-out-expo); } }
	@media(min-width:1024px) { .services__progress { display: block; } }
	@media(prefers-reduced-motion:reduce) { .services [data-services-progress] { transform: none !important; }.service::before { transition: none; } }
	.services h2 > span { padding: .15em 0; margin: -.15em 0; }
</style>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);
	const services = document.querySelector<HTMLElement>('[data-services]');
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	if (services && !services.dataset.ready) {
		services.dataset.ready = 'true';
		const items = [...services.querySelectorAll<HTMLElement>('[data-service]')];
		const close = (item: HTMLElement) => { const trigger = item.querySelector<HTMLButtonElement>('[data-service-trigger]'); const panel = item.querySelector<HTMLElement>('[data-service-panel]'); item.classList.remove('is-open'); trigger?.setAttribute('aria-expanded', 'false'); if (panel) gsap.to(panel, { height: 0, autoAlpha: 0, duration: .45, ease: 'power3.out', overwrite: true }); };
		const open = (item: HTMLElement) => { const trigger = item.querySelector<HTMLButtonElement>('[data-service-trigger]'); const panel = item.querySelector<HTMLElement>('[data-service-panel]'); items.filter((other) => other !== item).forEach(close); item.classList.add('is-open'); items.forEach((other) => other.classList.toggle('is-dim', other !== item)); trigger?.setAttribute('aria-expanded', 'true'); if (panel) { gsap.to(panel, { height: 'auto', autoAlpha: 1, duration: .45, ease: 'power3.out', overwrite: true }); gsap.fromTo(panel.querySelectorAll('[data-service-word]'), { autoAlpha: 0, y: 8, filter: 'blur(3px)' }, { autoAlpha: 1, y: 0, filter: 'blur(0px)', duration: .4, stagger: .022, delay: .12, ease: 'power3.out', overwrite: true }); gsap.fromTo(panel.querySelectorAll('[data-service-tag]'), { autoAlpha: 0, y: 10, clipPath: 'inset(100% 0 0 0)' }, { autoAlpha: 1, y: 0, clipPath: 'inset(0 0 0 0)', duration: .4, stagger: .07, delay: .12, ease: 'power3.out', overwrite: true }); } };
		services.classList.add('has-js');
		const clickHandlers = items.map((item) => { const trigger = item.querySelector<HTMLButtonElement>('[data-service-trigger]'); const handler = () => { item.classList.contains('is-open') ? (close(item), items.forEach((other) => other.classList.remove('is-dim'))) : open(item); }; trigger?.addEventListener('click', handler); return { trigger, handler }; });
		const context = gsap.context(() => { if (!reducedMotion) { const timeline = gsap.timeline({ scrollTrigger: { trigger: services, start: 'top 76%', once: true } }); timeline.from('[data-services-label]', { x: -16, autoAlpha: 0, duration: .6 }).from('[data-services-rule]', { scaleX: 0, duration: 1.4, ease: 'power4.inOut' }, 0).from('[data-services-title] > span > *', { yPercent: 110, duration: .7, stagger: .1, ease: 'power3.out' }, .1); gsap.from('.service__title-mask strong', { yPercent: 110, duration: .75, stagger: .09, ease: 'power3.out', scrollTrigger: { trigger: '.services__list', start: 'top 80%', once: true } }); gsap.fromTo('[data-services-progress]', { scaleY: 0 }, { scaleY: 1, ease: 'none', scrollTrigger: { trigger: services, start: 'top 65%', end: 'bottom 35%', scrub: 1.5 } }); } }, services);
		const refresh = () => ScrollTrigger.refresh(); window.addEventListener('load', refresh, { once: true }); window.addEventListener('resize', refresh); window.addEventListener('pagehide', () => { window.removeEventListener('resize', refresh); clickHandlers.forEach(({ trigger, handler }) => trigger?.removeEventListener('click', handler)); context.revert(); }, { once: true });
	}
</script>
