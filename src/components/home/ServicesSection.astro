---
import { services } from '../../data/site';

const details = [
	['Actualizaciones', 'Respaldos', 'Corrección de errores', 'Soporte técnico'],
	['Monitoreo', 'Protección de accesos', 'Revisión de vulnerabilidades', 'Recuperación'],
	['Contacto directo', 'Llamados a la acción', 'Conversaciones inmediatas', 'Experiencia móvil'],
];
const symbols = ['↻', '◇', '↗'];
---

<section class="services" id="services" data-services aria-labelledby="services-title">
	<div class="services__inner">
		<header class="services__heading">
			<p><span>03</span> Servicios</p>
			<div>
				<h2 id="services-title">Tu web activa, segura<br />y preparada para <em>evolucionar.</em></h2>
				<p>El desarrollo es solo el inicio. Te acompañamos para mantener, proteger y conectar tu plataforma con las necesidades reales del negocio.</p>
			</div>
		</header>

		<div class="services__list">
			{services.map((service, index) => (
				<article class="service-row" data-service-row>
					<div class="service-row__number"><span>0{index + 1}</span><i aria-hidden="true">{symbols[index]}</i></div>
					<div class="service-row__title"><p>Servicio</p><h3>{service.title}</h3></div>
					<div class="service-row__copy"><p>{service.description}</p><ul>{details[index].map((detail) => <li>{detail}</li>)}</ul></div>
					<a href={service.href} aria-label={`Ver ${service.title}`}><span>Ver servicio</span><b>↗</b></a>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.services { border-top: 1px solid rgba(10,10,10,.08); background: #fff; color: #0a0a0a; }
	.services__inner { width: min(1360px,calc(100% - 48px)); margin: auto; padding: clamp(6.5rem,10vw,10rem) 0; }
	.services__heading > p { display: flex; gap: 10px; margin: 0 0 26px; align-items: center; color: var(--color-brand); font-size: .7rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
	.services__heading > p span { display: grid; width: 28px; height: 28px; place-items: center; border: 1px solid rgba(var(--color-brand-rgb),.4); border-radius: 50%; font-size: .58rem; }
	.services__heading > div { display: grid; gap: 28px 70px; align-items: end; }
	.services h2 { color: #0a0a0a; font-size: clamp(2.8rem,5.7vw,6.3rem); font-weight: 700; letter-spacing: -.06em; line-height: .98; }
	.services h2 em { color: var(--color-brand); font-style: normal; }
	.services__heading > div > p { max-width: 440px; margin: 0; color: rgba(10,10,10,.58); font-size: .96rem; line-height: 1.75; }
	.services__list { margin-top: clamp(3.5rem,7vw,6rem); border-top: 1px solid rgba(10,10,10,.13); }
	.service-row { position: relative; display: grid; min-height: 250px; padding: clamp(1.6rem,3.2vw,2.8rem) 0; align-items: center; border-bottom: 1px solid rgba(10,10,10,.13); transition: background .25s ease; }
	.service-row::before { position: absolute; inset: 0 calc(50% - 50vw); z-index: 0; background: rgba(10,10,10,.022); opacity: 0; content: ''; transition: opacity .25s ease; }
	.service-row:hover::before { opacity: 1; }
	.service-row > * { position: relative; z-index: 1; }
	.service-row__number { display: flex; gap: 14px; align-items: center; }
	.service-row__number > span { color: rgba(10,10,10,.34); font-size: .64rem; font-weight: 700; letter-spacing: .12em; }
	.service-row__number i { display: grid; width: 48px; height: 48px; place-items: center; border: 1px solid rgba(var(--color-brand-rgb),.26); border-radius: 50%; color: var(--color-brand); font-size: 1.15rem; font-style: normal; }
	.service-row__title > p { margin: 0 0 11px; color: var(--color-brand); font-size: .58rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
	.service-row h3 { margin: 0; color: #0a0a0a; font-size: clamp(2rem,3.6vw,4rem); font-weight: 700; letter-spacing: -.055em; line-height: 1; }
	.service-row__copy > p { max-width: 450px; margin: 0; color: rgba(10,10,10,.58); font-size: .88rem; line-height: 1.7; }
	.service-row ul { display: flex; flex-wrap: wrap; gap: 7px; margin: 20px 0 0; padding: 0; list-style: none; }
	.service-row li { padding: 6px 8px; border: 1px solid rgba(10,10,10,.12); border-radius: 6px; color: rgba(10,10,10,.5); font-size: .55rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
	.service-row > a { display: flex; gap: 14px; align-items: center; justify-self: end; color: rgba(10,10,10,.72); }
	.service-row > a > span { font-size: .62rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
	.service-row > a b { display: grid; width: 42px; height: 42px; place-items: center; border: 1px solid rgba(10,10,10,.16); border-radius: 50%; color: var(--color-brand-deep); font-size: 1rem; transition: background .2s ease,color .2s ease; }
	.service-row > a:hover b { background: var(--color-brand); color: #050505; }
	@media(min-width:940px) { .services__heading > div { grid-template-columns: minmax(0,1.3fr) minmax(300px,.45fr); }.service-row { grid-template-columns: 120px minmax(260px,.8fr) minmax(330px,1fr) 150px; gap: 28px; } }
	@media(max-width:939px) { .service-row { grid-template-columns: 80px minmax(0,1fr) auto; gap: 24px; }.service-row__copy { grid-column: 2 / -1; }.service-row > a { grid-column: 2 / -1; justify-self: start; }.service-row__number { align-self: start; flex-direction: column; }.service-row__number > span { align-self: flex-start; } }
	@media(max-width:600px) { .services__inner { width: min(100% - 28px,1360px); }.service-row { grid-template-columns: 54px minmax(0,1fr); gap: 18px; }.service-row__number i { width: 42px; height: 42px; }.service-row__title { align-self: center; }.service-row__copy,.service-row > a { grid-column: 1 / -1; }.service-row h3 { font-size: clamp(2rem,10vw,3rem); } }
</style>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	gsap.registerPlugin(ScrollTrigger);
	const services = document.querySelector<HTMLElement>('[data-services]');
	if (services && !services.dataset.ready && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		services.dataset.ready = 'true';
		const context = gsap.context(() => {
			gsap.from('.services__heading > *', { y: 26, autoAlpha: 0, duration: .6, stagger: .09, ease: 'power3.out', scrollTrigger: { trigger: services, start: 'top 78%', once: true } });
			gsap.from('[data-service-row]', { y: 28, autoAlpha: 0, duration: .58, stagger: .09, ease: 'power3.out', scrollTrigger: { trigger: '.services__list', start: 'top 84%', once: true } });
		}, services);
		window.addEventListener('pagehide', () => context.revert(), { once: true });
	}
</script>
