---
import { projects } from '../../data/projects';

// The source data has no id or year. This adapter keeps those fields optional.
const workProjects = projects.map((project, index) => ({
	id: `${index + 1}-${project.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`,
	title: project.title,
	category: project.category,
	description: project.description,
	technologies: project.tags,
	image: project.image,
	year: undefined,
	url: project.url,
}));
const count = workProjects.length;
const pad = (number: number) => String(number).padStart(2, '0');
---

<section class="work" id="work" data-work style={`--work-scenes:${count + 1}`} aria-labelledby="work-title">
	<div class="work-sticky">
		<canvas class="work-particles" data-work-particles aria-hidden="true"></canvas>
		<div class="work-halos" aria-hidden="true"></div>
		<div class="work-hud work-hud--left" aria-hidden="true"><span>02 / TRABAJOS</span><i></i><small>{count} PROYECTOS</small></div>
		<div class="work-hud work-hud--right" aria-hidden="true"><strong data-work-percent>000%</strong><span><b data-work-progress></b></span><small data-work-category>RESUMEN</small></div>
		<div class="work-dots" aria-hidden="true">{Array.from({ length: count + 1 }, (_, index) => <i data-work-dot={index}></i>)}</div>
		<div class="work-scene-label" data-work-scene aria-hidden="true">00 / RESUMEN</div>
		<div class="work-counter" data-work-counter aria-hidden="true">00 / {pad(count)}</div>

		<div class="work-intro" data-work-intro>
			<p>TRABAJOS SELECCIONADOS · {count} PROYECTOS</p>
			<h2 id="work-title">Proyectos <em>seleccionados</em></h2>
			<span>SCROLL PARA EXPLORAR</span>
		</div>

		<div class="work-prism-wrap" aria-hidden="true"><div class="work-prism" data-work-prism>
			{Array.from({ length: 6 }, (_, index) => {
				const project = workProjects[index % count];
				return <div class={`work-face work-face--${index + 1}`}><img data-work-face data-src={project?.image} alt="" /><span></span></div>;
			})}
		</div></div>

		<div class="work-cards">
			<div class="work-card-slot work-card-slot--left" data-work-slot="left"></div>
			<div class="work-card-slot work-card-slot--right" data-work-slot="right"></div>
			<div class="work-card-templates" aria-hidden="true">
			{workProjects.map((project, index) => (
				<article class:list={['work-card', { 'work-card--right': index % 2 === 1 }]} data-work-card={index} data-image={project.image} aria-hidden="true">
					{(project.category || project.year) && <p class="work-card__meta">{project.category}{project.year && ` / ${project.year}`}</p>}
					<h3>{project.title}</h3>
					{project.description && <p class="work-card__description">{project.description}</p>}
					{project.technologies.length > 0 && <ul>{project.technologies.map((technology) => <li>{technology}</li>)}</ul>}
					{project.url && <a href={project.url} target="_blank" rel="noopener noreferrer">VER PROYECTO <b>↗</b></a>}
				</article>
			))}
			</div>
		</div>
	</div>

	<div class="work-mobile">
		<header><p>02 / TRABAJOS</p><i></i><span>{count} PROYECTOS</span></header>
		<h2>Proyectos <em>seleccionados</em></h2>
		<div class="work-mobile__list">
			{workProjects.map((project, index) => (
				<article data-work-mobile-card>
					<div class="work-mobile__image"><img src={project.image} alt={project.title} width="960" height="600" loading="lazy" decoding="async" /><span></span><b>{pad(index + 1)}</b><div>{(project.category || project.year) && <small>{project.category}{project.year && ` / ${project.year}`}</small>}<h3>{project.title}</h3></div></div>
					{project.description && <p>{project.description}</p>}
					{project.technologies.length > 0 && <ul>{project.technologies.map((technology) => <li>{technology}</li>)}</ul>}
					{project.url && <a href={project.url} target="_blank" rel="noopener noreferrer">VER PROYECTO <b>↗</b></a>}
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.work { position: relative; height: calc(var(--work-scenes) * 65svh); min-height: 280svh; overflow: clip; background: #050505; color: rgba(255,255,255,.9); }
	.work-sticky { position: sticky; top: 0; height: 100svh; overflow: hidden; isolation: isolate; }
	.work-halos { position: absolute; inset: 0; z-index: -1; pointer-events: none; background: radial-gradient(circle at 22% 76%,rgba(255,255,255,.045),transparent 30%),radial-gradient(circle at 82% 18%,rgba(255,255,255,.025),transparent 27%); }
	.work-particles { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
	.work-hud,.work-dots,.work-counter,.work-scene-label { position: absolute; z-index: 3; pointer-events: none; font-size: 10px; font-weight: 600; letter-spacing: .16em; }
	.work-hud { top: clamp(5.5rem,9vw,8rem); display: flex; color: rgba(255,255,255,.55); text-transform: uppercase; }
	.work-hud--left { left: clamp(1.25rem,4vw,5rem); flex-direction: column; gap: 10px; }.work-hud--left i { width: 32px; height: 1px; background: rgba(255,255,255,.35); }.work-hud small { font-size: inherit; }
	.work-hud--right { right: clamp(1.25rem,4vw,5rem); width: 96px; flex-direction: column; align-items: flex-end; gap: 9px; }.work-hud--right strong { color: var(--color-brand); font-size: 11px; }.work-hud--right > span { width: 96px; height: 1px; background: rgba(255,255,255,.18); }.work-hud--right b { display: block; width: 0%; height: 100%; background: var(--color-brand); }.work-hud--right small { text-align: right; }
	.work-dots { top: 50%; left: clamp(1.25rem,4vw,5rem); display: grid; gap: 12px; transform: translateY(-50%); }.work-dots i { width: 4px; height: 4px; border-radius: 50%; background: rgba(255,255,255,.25); transition: background .2s ease,transform .2s ease; }.work-dots i.is-active { background: var(--color-brand); box-shadow: 0 0 8px var(--color-brand); transform: scale(1.6); }
	.work-counter { right: clamp(1.25rem,4vw,5rem); bottom: clamp(2rem,4vw,4rem); color: rgba(255,255,255,.65); }.work-scene-label { bottom: clamp(1.5rem,3vw,3rem); left: 50%; color: rgba(255,255,255,.12); font-size: clamp(1.2rem,2.8vw,3rem); letter-spacing: -.04em; transform: translateX(-50%); white-space: nowrap; }
	.work-intro { position: absolute; z-index: 2; top: 50%; left: 50%; width: min(900px,calc(100% - 48px)); padding: clamp(3rem,7vw,6rem) 1rem; overflow: hidden; text-align: center; transform: translate(-50%,-50%); }.work-intro::before { position: absolute; inset: 0; z-index: -1; border: 1px solid rgba(var(--color-brand-rgb),.12); background-color: #0a0a0a; background-image: repeating-linear-gradient(0deg,transparent 0 58px,rgba(8,189,242,.045) 59px),repeating-linear-gradient(90deg,transparent 0 58px,rgba(8,189,242,.045) 59px); content: ''; }.work-intro p,.work-intro > span { display: block; color: rgba(255,255,255,.52); font-size: 10px; font-weight: 600; letter-spacing: .18em; }.work-intro p { margin: 0 0 20px; color: var(--color-brand); }.work-intro > span { margin-top: 28px; }.work-intro h2,.work-mobile h2 { margin: 0; color: rgba(255,255,255,.92); font-size: clamp(3.8rem,9vw,10rem); font-weight: 800; letter-spacing: -.075em; line-height: .9; }.work-intro h2 em,.work-mobile h2 em { color: var(--color-brand); font-family: var(--font-primary); font-style: normal; font-weight: 800; }
	.work-prism-wrap { position: absolute; top: 50%; left: 50%; width: min(72vw,700px); aspect-ratio: 16 / 9; perspective: 1100px; transform: translate(-50%,-50%); }.work-prism { position: absolute; inset: 0; transform-style: preserve-3d; }.work-face { position: absolute; inset: 0; overflow: hidden; border: 1px solid rgba(255,255,255,.11); background-color: #101010; background-image: repeating-linear-gradient(0deg,transparent 0 22px,rgba(255,255,255,.045) 23px),repeating-linear-gradient(90deg,transparent 0 22px,rgba(255,255,255,.045) 23px); backface-visibility: hidden; }.work-face img { display: block; width: 100%; height: 100%; object-fit: cover; }.work-face span { position: absolute; inset: 0; background: rgba(0,0,0,.28); }.work-face--1 { transform: translateZ(min(36vw,350px)); }.work-face--2 { transform: rotateY(90deg) translateZ(min(36vw,350px)); }.work-face--3 { transform: rotateY(180deg) translateZ(min(36vw,350px)); }.work-face--4 { transform: rotateY(-90deg) translateZ(min(36vw,350px)); }.work-face--5 { transform: rotateX(90deg) translateZ(min(36vw,350px)); }.work-face--6 { transform: rotateX(-90deg) translateZ(min(36vw,350px)); }
	.work-cards { position: absolute; inset: 0; z-index: 4; pointer-events: none; }.work-card-slot { position: absolute; top: 0; bottom: 0; display: grid; align-content: center; width: min(21rem,28%); }.work-card-slot--left { left: clamp(4rem,7vw,7rem); }.work-card-slot--right { right: clamp(4rem,7vw,7rem); }.work-card-templates { display: none; }.work-card { grid-area: 1 / 1; padding: 24px; border: 1px solid rgba(255,255,255,.07); background: rgba(12,12,12,.92); text-align: left; pointer-events: none; will-change: transform,opacity; }.work-card-transition[data-side='left'][data-state='enter'] { animation: work-card-enter-left .38s cubic-bezier(.22,1,.36,1) both; }.work-card-transition[data-side='left'][data-state='exit'] { animation: work-card-exit-left .38s cubic-bezier(.22,1,.36,1) both; }.work-card-transition[data-side='right'][data-state='enter'] { animation: work-card-enter-right .38s cubic-bezier(.22,1,.36,1) both; }.work-card-transition[data-side='right'][data-state='exit'] { animation: work-card-exit-right .38s cubic-bezier(.22,1,.36,1) both; }.work-card__meta { margin: 0; color: rgba(255,255,255,.45); font-size: 10px; font-weight: 600; letter-spacing: .15em; text-transform: uppercase; }.work-card h3 { margin: 15px 0 12px; color: rgba(255,255,255,.9); font-size: clamp(1.7rem,2.3vw,2.5rem); font-weight: 900; letter-spacing: -.07em; line-height: .95; }.work-card__description { margin: 0; color: rgba(255,255,255,.52); font-size: 12px; line-height: 1.65; }.work-card ul,.work-mobile article ul { display: flex; flex-wrap: wrap; gap: 6px; margin: 18px 0 0; padding: 0; list-style: none; }.work-card li,.work-mobile article li { padding: 6px 8px; border: 1px solid rgba(255,255,255,.13); color: rgba(255,255,255,.55); font-size: 9px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }.work-card > a,.work-mobile article > a { display: inline-flex; min-height: 44px; gap: 12px; margin-top: 20px; padding: 0 15px; align-items: center; border: 1px solid rgba(255,255,255,.2); border-radius: 999px; color: rgba(255,255,255,.88); font-size: 10px; font-weight: 700; letter-spacing: .12em; }.work-card > a b,.work-mobile article > a b { font-size: 14px; }.work-mobile { display: none; }@keyframes work-card-enter-left { from { opacity: 0; transform: translateX(-14px); } to { opacity: 1; transform: translateX(0); } }@keyframes work-card-exit-left { from { opacity: 1; transform: translateX(0); } to { opacity: 0; transform: translateX(-14px); } }@keyframes work-card-enter-right { from { opacity: 0; transform: translateX(14px); } to { opacity: 1; transform: translateX(0); } }@keyframes work-card-exit-right { from { opacity: 1; transform: translateX(0); } to { opacity: 0; transform: translateX(14px); } }
	@media(max-width:767px) { .work { height: auto; overflow: visible; }.work-sticky { display: none; }.work-mobile { display: block; padding: 6rem 20px; }.work-mobile header { display: flex; gap: 12px; align-items: center; color: rgba(255,255,255,.48); font-size: 10px; font-weight: 600; letter-spacing: .15em; }.work-mobile header p { margin: 0; }.work-mobile header i { height: 1px; flex: 1; background: rgba(255,255,255,.18); }.work-mobile header span { white-space: nowrap; }.work-mobile h2 { margin: 34px 0 48px; font-size: clamp(3.6rem,16vw,6rem); }.work-mobile__list { display: grid; gap: 16px; }.work-mobile article { overflow: hidden; border: 1px solid rgba(255,255,255,.08); border-radius: 14px; background: rgba(255,255,255,.025); }.work-mobile__image { position: relative; aspect-ratio: 16 / 10; overflow: hidden; }.work-mobile__image img { width: 100%; height: 100%; object-fit: cover; }.work-mobile__image > span { position: absolute; inset: 35% 0 0; background: linear-gradient(transparent,rgba(0,0,0,.82)); }.work-mobile__image > b { position: absolute; top: 14px; left: 14px; color: rgba(255,255,255,.75); font-size: 10px; letter-spacing: .15em; }.work-mobile__image > div { position: absolute; right: 18px; bottom: 17px; left: 18px; }.work-mobile__image small { color: rgba(255,255,255,.6); font-size: 9px; font-weight: 600; letter-spacing: .15em; text-transform: uppercase; }.work-mobile h3 { margin: 7px 0 0; color: rgba(255,255,255,.92); font-size: clamp(1.8rem,8vw,2.5rem); font-weight: 900; letter-spacing: -.07em; line-height: .95; }.work-mobile article > p,.work-mobile article > ul,.work-mobile article > a { margin-left: 18px; margin-right: 18px; }.work-mobile article > p { margin-top: 18px; margin-bottom: 0; color: rgba(255,255,255,.52); font-size: 13px; line-height: 1.65; }.work-mobile article > a { margin-bottom: 18px; } }
	@media(prefers-reduced-motion:reduce) and (min-width:768px) { .work { height: auto; }.work-sticky { display: none; }.work-mobile { display: block; padding: 8rem max(5vw,20px); }.work-mobile__list { grid-template-columns: repeat(2,minmax(0,1fr)); }.work-mobile h2 { font-size: clamp(3.6rem,10vw,7rem); } }
	@media(min-width:768px) { .work-intro h2 { font-size: clamp(2.8rem,6vw,6.5rem); line-height: .94; }.work-card--right { text-align: right; }.work-card--right ul { justify-content: flex-end; } }
	@media(max-width:767px) { .work-mobile h2 { font-size: clamp(2.7rem,12vw,4.2rem); line-height: .96; } }
</style>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);
	const work = document.querySelector<HTMLElement>('[data-work]');
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	if (work && !work.dataset.ready) {
		work.dataset.ready = 'true';
		const projectCount = Number(work.style.getPropertyValue('--work-scenes')) - 1;
		const cards = [...work.querySelectorAll<HTMLElement>('[data-work-card]')];
		const dots = [...work.querySelectorAll<HTMLElement>('[data-work-dot]')];
		const prism = work.querySelector<HTMLElement>('[data-work-prism]');
		const intro = work.querySelector<HTMLElement>('[data-work-intro]');
		const category = work.querySelector<HTMLElement>('[data-work-category]');
		const counter = work.querySelector<HTMLElement>('[data-work-counter]');
		const percent = work.querySelector<HTMLElement>('[data-work-percent]');
		const progress = work.querySelector<HTMLElement>('[data-work-progress]');
		const sceneLabel = work.querySelector<HTMLElement>('[data-work-scene]');
		const titles = cards.map((card) => card.querySelector('h3')?.textContent ?? '');
		const categories = cards.map((card) => card.querySelector('.work-card__meta')?.textContent ?? '');
		const faces = [...work.querySelectorAll<HTMLImageElement>('[data-work-face]')];
		const slots = { left: work.querySelector<HTMLElement>('[data-work-slot="left"]'), right: work.querySelector<HTMLElement>('[data-work-slot="right"]') };
		let active = -1;
		const pad = (value: number) => String(value).padStart(2, '0');
		const setFaceSources = (index: number) => faces.forEach((face, faceIndex) => { const source = cards[(index + faceIndex) % projectCount]?.dataset.image ?? face.dataset.src; if (source && !face.src.endsWith(source)) face.src = source; });
		const transitionCard = (index: number) => {
			const side = index % 2 === 0 ? 'left' : 'right'; const slot = slots[side]; const source = cards[index];
			if (!slot || !source) return;
			work.querySelectorAll<HTMLElement>('.work-card-transition[data-state="exit"]').forEach((card) => card.remove());
			work.querySelectorAll<HTMLElement>('.work-card-transition').forEach((card) => {
				card.dataset.state = 'exit'; card.addEventListener('animationend', () => card.remove(), { once: true });
			});
			const incoming = source.cloneNode(true) as HTMLElement;
			incoming.classList.add('work-card-transition'); incoming.dataset.side = side; incoming.dataset.state = 'enter'; incoming.setAttribute('aria-hidden', 'false'); slot.append(incoming);
		};
		const render = (value: number) => {
			const scene = value * projectCount;
			const next = Math.min(projectCount - 1, Math.max(-1, Math.round(scene) - 1));
			const eased = scene < 1 ? scene * scene * (3 - 2 * scene) : 1;
			if (prism) { prism.style.transform = `rotateX(${90 * (1 - Math.min(1, eased))}deg) rotateY(${-90 * Math.max(0, scene - 1)}deg)`; prism.style.opacity = next < 0 ? '0' : '1'; }
			if (percent) percent.textContent = `${pad(Math.round(value * 100))}%`; if (progress) progress.style.width = `${value * 100}%`;
			if (next === active) return;
			active = next; dots.forEach((dot, index) => dot.classList.toggle('is-active', index === active + 1));
			if (intro) gsap.to(intro, { autoAlpha: active < 0 ? 1 : 0, y: active < 0 ? 0 : -14, duration: .45, overwrite: true });
			if (active >= 0) transitionCard(active); else work.querySelectorAll<HTMLElement>('.work-card-transition').forEach((card) => card.remove());
			if (category) category.textContent = active < 0 ? 'RESUMEN' : (categories[active] || '').toUpperCase(); if (counter) counter.textContent = active < 0 ? `00 / ${pad(projectCount)}` : `${pad(active + 1)} / ${pad(projectCount)}`; if (sceneLabel) sceneLabel.textContent = active < 0 ? '00 / RESUMEN' : `${pad(active + 1)} / ${(categories[active] || titles[active]).toUpperCase()}`;
			setFaceSources(Math.max(0, active));
		};
		const mobileCards = [...work.querySelectorAll<HTMLElement>('[data-work-mobile-card]')];
		const context = gsap.context(() => {
			if (!reducedMotion && window.innerWidth >= 768) {
				gsap.from(intro, { autoAlpha: 0, y: 14, duration: .45, ease: 'power2.out' }); render(0);
				ScrollTrigger.create({ trigger: work, start: 'top top', end: 'bottom bottom', scrub: .45, invalidateOnRefresh: true, onUpdate: (self) => render(self.progress) });
			} else if (!reducedMotion) mobileCards.forEach((card) => gsap.from(card, { autoAlpha: 0, y: 26, duration: .55, ease: 'power3.out', scrollTrigger: { trigger: card, start: 'top 88%', once: true } }));
		}, work);
		const refresh = () => ScrollTrigger.refresh(); window.addEventListener('resize', refresh); window.addEventListener('pagehide', () => { window.removeEventListener('resize', refresh); context.revert(); }, { once: true });
		const canvas = work.querySelector<HTMLCanvasElement>('[data-work-particles]');
		if (canvas && !reducedMotion && window.innerWidth >= 768) {
			const context = canvas.getContext('2d'); const particles = Array.from({ length: 140 }, () => ({ x: Math.random(), y: Math.random(), size: Math.random() * 1.3 + .2, alpha: Math.random() * .11 + .01, speed: Math.random() * .00018 + .00004 }));
			let frame = 0; const draw = () => { if (!document.hidden && context) { canvas.width = canvas.clientWidth * devicePixelRatio; canvas.height = canvas.clientHeight * devicePixelRatio; context.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0); context.clearRect(0, 0, canvas.clientWidth, canvas.clientHeight); particles.forEach((particle) => { particle.y -= particle.speed; if (particle.y < 0) particle.y = 1; context.fillStyle = `rgba(255,255,255,${particle.alpha})`; context.fillRect(particle.x * canvas.clientWidth, particle.y * canvas.clientHeight, particle.size, particle.size); }); } frame = requestAnimationFrame(draw); }; draw(); window.addEventListener('pagehide', () => cancelAnimationFrame(frame), { once: true });
		}
	}
</script>
