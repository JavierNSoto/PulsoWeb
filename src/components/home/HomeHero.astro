---
import { home } from '../../data/home';
---

<section class="hero" id="home" data-hero>
	<div class="hero-card">
		<video autoplay muted loop playsinline poster={home.assets.poster} data-hero-media>
			<source src={home.assets.video} type="video/mp4" />
		</video>
		<div class="hero-card__overlay" aria-hidden="true"></div>
		<div class="hero-card__content">
			<div class="hero-card__meta" data-hero-badge>
				<span class="availability"><i></i>{home.availability}</span>
				<span>{home.location}</span>
			</div>
			<h1 aria-label={home.name.join(' ')}>
				<span data-scramble={home.name[0]}>{home.name[0]}</span>
				<span data-scramble={home.name[1]}>{home.name[1]}</span>
			</h1>
			<p class="hero-card__tagline" data-scramble={home.headline}>{home.headline}</p>
			<div class="hero-card__tech" aria-label="Tecnologías">
				{home.technologies.map((technology) => <span data-hero-tag>{technology}</span>)}
			</div>
			<div class="hero-card__actions">
				<a class="hero-card__primary" href={home.links.projects} data-hero-action>VER PROYECTOS <b>↗</b></a>
				<a class="hero-card__secondary" href={home.links.contact} data-hero-action>CONTACTAR</a>
			</div>
		</div>
		<p class="hero-card__vertical">Diseño y desarrollo digital / 2026</p>
	</div>
</section>

<style>
	.hero { min-height: 100svh; padding: clamp(4px,.6vw,10px); background: var(--canvas); }
	.hero-card { position: relative; min-height: calc(100svh - clamp(8px,1.2vw,20px)); overflow: hidden; border: 1px solid rgba(255,255,255,.92); border-radius: clamp(16px,2vw,28px); background: #111; color: #fff; will-change: transform,opacity; }
	.hero-card video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; background: #141414; }
	.hero-card__overlay { position: absolute; inset: 0; background: radial-gradient(ellipse 85% 78% at 18% 100%,rgba(0,0,0,.55) 0%,rgba(0,0,0,.32) 42%,rgba(0,0,0,0) 80%); }
	.hero-card__content { position: relative; z-index: 1; display: flex; min-height: calc(100svh - clamp(8px,1.2vw,20px)); padding: clamp(7rem,14vh,10rem) clamp(1rem,4vw,5rem) clamp(2.5rem,6vw,6rem); flex-direction: column; justify-content: flex-end; }
	.hero-card__meta { display: flex; gap: 12px; align-items: center; margin-bottom: clamp(1.5rem,3vw,3rem); color: #d9d9d9; font-size: 9px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; }
	.availability { display: inline-flex; gap: 8px; padding: 8px 10px; align-items: center; border: 1px solid rgba(255,255,255,.65); border-radius: 999px; }
	.availability i { width: 5px; height: 5px; border-radius: 50%; background: #fff; animation: pulse 1.8s ease infinite; }
	.hero h1 { max-width: none; margin: 0; color: #fff; font-size: clamp(3.8rem,11.5vw,14rem); font-weight: 900; letter-spacing: -.09em; line-height: .88; mix-blend-mode: difference; }
	.hero h1 span { display: block; color: inherit; }
	.hero-card__tagline { max-width: 820px; margin: clamp(1.2rem,2vw,2rem) 0 0; color: #d9d9d9; font-family: var(--font-editorial); font-size: clamp(1.25rem,3vw,3rem); font-style: italic; line-height: 1.25; mix-blend-mode: difference; }
	.hero-card__tech { display: flex; flex-wrap: wrap; gap: 7px; margin-top: clamp(1.5rem,3vw,2.5rem); }
	.hero-card__tech span { padding: 8px 10px; border: 1px solid rgba(255,255,255,.55); color: #fff; font-size: 10px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
	.hero-card__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: clamp(1.5rem,3vw,2.8rem); }
	.hero-card__actions a { display: inline-flex; min-height: 48px; padding: 0 18px; align-items: center; justify-content: center; font-size: 10px; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; transition: transform .2s var(--ease-out-expo),background .2s ease; }
	.hero-card__actions a:hover { transform: translateY(-3px); }
	.hero-card__primary { gap: 18px; background: #0a0a0a; color: #fff; }
	.hero-card__primary b { font-size: 15px; }
	.hero-card__secondary { border: 1px solid rgba(255,255,255,.75); color: #fff; }
	.hero-card__vertical { position: absolute; z-index: 1; top: 50%; right: clamp(1rem,2vw,2.5rem); margin: 0; color: rgba(255,255,255,.7); font-size: 9px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; writing-mode: vertical-rl; transform: translateY(-50%) rotate(180deg); }
	@keyframes pulse { 50% { opacity: .35; transform: scale(.65); } }
	@media(max-width:767px) { .hero-card__meta { flex-wrap: wrap; } .hero-card__vertical { display: none; } }
	@media(prefers-reduced-motion:reduce) { .availability i { animation: none; } }
</style>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);
	const hero = document.querySelector<HTMLElement>('[data-hero]');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	if (hero && !hero.dataset.animated) {
		hero.dataset.animated = 'true';
		const context = gsap.context(() => {
			const card = hero.querySelector<HTMLElement>('.hero-card');
			const media = hero.querySelector<HTMLVideoElement>('[data-hero-media]');
			const scramble = (element: HTMLElement, duration = 820) => {
				const text = element.dataset.scramble ?? element.textContent ?? ''; const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#@_!'; const start = performance.now();
				const frame = (now: number) => { const progress = Math.min(1, (now - start) / duration); const revealed = Math.floor(progress * text.length); element.textContent = [...text].map((character, index) => index < revealed || character === ' ' ? character : chars[Math.floor(Math.random() * chars.length)]).join(''); if (progress < 1) requestAnimationFrame(frame); else element.textContent = text; };
				requestAnimationFrame(frame);
			};
			if (!reduceMotion) {
				const texts = [...hero.querySelectorAll<HTMLElement>('[data-scramble]')];
				texts.forEach((element) => element.addEventListener('mouseenter', () => scramble(element, 600), { passive: true }));
				gsap.from('[data-hero-badge]', { x: -24, autoAlpha: 0, duration: .6, delay: 1.4, ease: 'power3.out' });
				gsap.from('[data-hero-tag]', { clipPath: 'inset(100% 0 0 0)', duration: .55, stagger: .07, delay: 1.6, ease: 'power3.out' });
				gsap.from('[data-hero-action]', { y: 20, autoAlpha: 0, duration: .6, stagger: .1, delay: 2.1, ease: 'power3.out' });
				ScrollTrigger.matchMedia({
					'(min-width: 1024px)': () => gsap.to(card, { scale: .92, opacity: .4, y: -40, transformOrigin: 'center center', ease: 'none', scrollTrigger: { trigger: hero, start: 'top top', end: '+=50%', scrub: 1.5, pin: true, pinSpacing: true, anticipatePin: 1, invalidateOnRefresh: true, snap: { snapTo: 1, duration: .4, ease: 'power1.inOut' } } }),
					'(max-width: 1023px)': () => gsap.to(card, { scale: .96, opacity: .55, y: -20, ease: 'none', scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: 1 } }),
				});
			}
			media?.addEventListener('loadeddata', () => ScrollTrigger.refresh(), { once: true });
			window.addEventListener('resize', () => ScrollTrigger.refresh());
		}, hero);
		window.addEventListener('pagehide', () => context.revert(), { once: true });
	}
</script>
