---
import { home } from '../../data/home';
---

<section class="hero" id="home" data-hero>
	<div class="hero__stage" data-hero-stage>
		<img class="hero__media" src={home.assets.poster} alt="Espacio de trabajo de diseño y desarrollo web" width="1920" height="1280" fetchpriority="high" />
		<div class="hero__veil" aria-hidden="true"></div>
		<div class="hero__glow" aria-hidden="true"></div>
		<div class="hero__content">
			<div class="hero__status" data-hero-item>
				<span><i></i>{home.availability}</span>
				<b>{home.location}</b>
			</div>
			<p class="hero__eyebrow" data-hero-item>Diseño · Desarrollo · Acompañamiento</p>
			<h1 data-hero-item>El pulso digital<br />de tu <em>negocio.</em></h1>
			<p class="hero__lead" data-hero-item>{home.headline} Soluciones profesionales, personalizadas y preparadas para crecer contigo.</p>
			<div class="hero__actions" data-hero-item>
				<a class="hero__primary" href={home.links.contact} target="_blank" rel="noopener noreferrer">Cuéntanos tu idea <span>↗</span></a>
				<a class="hero__secondary" href="#work">Ver proyectos <span>↓</span></a>
			</div>
			<div class="hero__services" data-hero-item aria-label="Servicios principales">
				{home.technologies.map((technology) => <span>{technology}</span>)}
			</div>
		</div>
		<div class="hero__scroll" aria-hidden="true"><i></i><span>Explora</span></div>
	</div>
</section>

<style>
	.hero { position: relative; min-height: 100svh; padding: clamp(6px,.65vw,10px); overflow: hidden; isolation: isolate; background: #fff; color: var(--color-white); }
	.hero__stage { position: relative; display: grid; min-height: calc(100svh - clamp(12px,1.3vw,20px)); overflow: hidden; place-items: center; isolation: isolate; border: 1px solid rgba(255,255,255,.22); border-radius: clamp(18px,2vw,30px); background: #050505; box-shadow: 0 18px 60px rgba(0,0,0,.15); will-change: transform,opacity,border-radius; }
	.hero__media { position: absolute; inset: 0; z-index: -3; width: 100%; height: 100%; object-fit: cover; opacity: .28; filter: saturate(.7) contrast(1.12); transform: scale(1.035); }
	.hero__veil { position: absolute; inset: 0; z-index: -2; background: linear-gradient(180deg,rgba(2,9,16,.82) 0%,rgba(2,9,16,.53) 44%,#020910 100%),linear-gradient(90deg,rgba(2,9,16,.62),transparent 45%,rgba(2,9,16,.55)); }
	.hero__veil::after { position: absolute; inset: 0; opacity: .2; background-image: linear-gradient(rgba(255,255,255,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.045) 1px,transparent 1px); background-size: 72px 72px; content: ''; mask-image: linear-gradient(transparent 8%,#000 48%,transparent 95%); }
	.hero__glow { position: absolute; z-index: -1; top: 28%; left: 50%; width: min(850px,90vw); height: min(420px,50vw); border-radius: 50%; background: rgba(var(--color-brand-rgb),.15); filter: blur(100px); transform: translate(-50%,-50%); }
	.hero__content { width: min(1320px,calc(100% - 80px)); padding: 148px 0 92px; text-align: left; }
	.hero__status { display: inline-flex; gap: 14px; margin-bottom: 32px; padding: 7px 12px; align-items: center; border: 1px solid rgba(8,189,242,.22); border-radius: 999px; background: rgba(8,189,242,.07); color: rgba(247,252,255,.62); font-size: .64rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
	.hero__status span { display: inline-flex; gap: 8px; align-items: center; color: var(--color-white); }
	.hero__status i { width: 6px; height: 6px; border-radius: 50%; background: var(--color-brand); box-shadow: 0 0 14px var(--color-brand); animation: pulse 1.7s ease infinite; }
	.hero__status b { font-weight: 600; }
	.hero__eyebrow { margin: 0 0 22px; color: var(--color-brand); font-size: .7rem; font-weight: 800; letter-spacing: .2em; text-transform: uppercase; }
	.hero h1 { max-width: 980px; color: var(--color-white); font-size: clamp(3.6rem,8vw,8.2rem); font-weight: 700; letter-spacing: -.072em; line-height: .91; }
	.hero h1 em { color: var(--color-brand); font-style: normal; font-weight: 700; text-shadow: 0 0 46px rgba(var(--color-brand-rgb),.28); }
	.hero__lead { max-width: 680px; margin: 32px 0 0; color: rgba(255,255,255,.68); font-size: clamp(1rem,1.45vw,1.22rem); line-height: 1.75; }
	.hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 38px; justify-content: flex-start; }
	.hero__actions a { display: inline-flex; min-height: 56px; gap: 24px; padding: 0 12px 0 22px; align-items: center; border-radius: 14px; font-size: .72rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; transition: transform .2s ease,box-shadow .2s ease,border-color .2s ease; }
	.hero__actions a span { display: grid; width: 34px; height: 34px; place-items: center; border-radius: 9px; }
	.hero__actions a:hover { transform: translateY(-3px); }
	.hero__primary { background: var(--color-brand); color: var(--color-night); box-shadow: 0 16px 42px rgba(var(--color-brand-rgb),.22); }
	.hero__primary span { background: rgba(2,9,16,.12); }
	.hero__primary:hover { box-shadow: 0 18px 48px rgba(var(--color-brand-rgb),.36); }
	.hero__secondary { border: 1px solid rgba(247,252,255,.2); background: rgba(247,252,255,.035); color: var(--color-white); }
	.hero__secondary span { background: rgba(247,252,255,.08); }
	.hero__secondary:hover { border-color: rgba(8,189,242,.5); }
	.hero__services { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 46px; justify-content: flex-start; }
	.hero__services span { padding: 7px 10px; border: 1px solid rgba(247,252,255,.1); border-radius: 7px; color: rgba(247,252,255,.45); font-size: .61rem; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }
	.hero__scroll { position: absolute; right: clamp(20px,3vw,48px); bottom: 36px; display: flex; gap: 10px; align-items: center; color: rgba(247,252,255,.4); font-size: .58rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; writing-mode: vertical-rl; }
	.hero__scroll i { width: 1px; height: 42px; background: linear-gradient(var(--color-brand),transparent); }
	@keyframes pulse { 50% { opacity: .35; transform: scale(.7); } }
	@media(max-width:767px) { .hero { padding: 5px; }.hero__stage { min-height: calc(100svh - 10px); }.hero__content { width: min(100% - 36px,1320px); padding-top: 130px; }.hero__status b { display: none; }.hero__lead { max-width: 530px; }.hero__scroll { display: none; }.hero__services { margin-top: 34px; } }
	@media(max-width:480px) { .hero__actions { flex-direction: column; }.hero__actions a { width: 100%; justify-content: space-between; }.hero h1 { font-size: clamp(2.7rem,12.2vw,3.5rem); } }
	@media(prefers-reduced-motion:reduce) { .hero__status i { animation: none; } }
</style>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	gsap.registerPlugin(ScrollTrigger);
	const hero = document.querySelector<HTMLElement>('[data-hero]');
	if (hero && !hero.dataset.ready && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		hero.dataset.ready = 'true';
		const stage = hero.querySelector<HTMLElement>('[data-hero-stage]');
		const context = gsap.context(() => {
			gsap.from('[data-hero-item]', { y: 24, autoAlpha: 0, duration: .7, stagger: .09, delay: .15, ease: 'power3.out' });
			gsap.to('.hero__media', { yPercent: 8, scale: 1.08, ease: 'none', scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: .35 } });
			ScrollTrigger.matchMedia({
				'(min-width: 900px)': () => gsap.to(stage, { scale: .94, y: -24, opacity: .62, borderRadius: 28, transformOrigin: 'center center', ease: 'none', scrollTrigger: { trigger: hero, start: 'top top', end: '+=30%', scrub: .4, pin: true, pinSpacing: true, anticipatePin: 1, invalidateOnRefresh: true } }),
				'(max-width: 899px)': () => gsap.to(stage, { scale: .97, opacity: .72, y: -16, ease: 'none', scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: .35 } }),
			});
		}, hero);
		window.addEventListener('pagehide', () => context.revert(), { once: true });
	}
</script>
