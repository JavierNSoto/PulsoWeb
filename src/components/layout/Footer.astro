---
import { home } from '../../data/home';
import { navigation } from '../../data/site';

const currentYear = new Date().getFullYear();
---

<footer class="footer" data-footer>
	<div class="footer__wordmark" aria-hidden="true">PulsoWeb</div>
	<div class="footer__inner">
		<div class="footer__top"><a class="footer__brand" href="/#home" data-footer-brand aria-label="PulsoWeb, inicio"><img src={home.assets.logo} alt="PulsoWeb" width="150" height="46" /></a></div>
		<nav class="footer__nav" data-footer-nav aria-label="Navegación del pie"><ul>{navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul></nav>
		<div class="footer__bottom" data-footer-bottom><p>© {currentYear} PulsoWeb. Todos los derechos reservados.</p></div>
	</div>
</footer>

<style>
	.footer { position: relative; overflow: hidden; border-top: 1px solid rgba(255,255,255,.06); background: #0a0a0a; color: #fff; }.footer__inner { position: relative; z-index: 1; width: min(1440px,100%); margin: auto; padding: clamp(3rem,5vw,5rem) clamp(1.25rem,5vw,5rem); }.footer__wordmark { position: absolute; bottom: -1vw; left: 50%; color: rgba(255,255,255,.032); font-size: clamp(4.5rem,18vw,22rem); font-weight: 900; letter-spacing: -.08em; line-height: .82; pointer-events: none; transform: translateX(-50%); white-space: nowrap; }.footer__top { display: flex; justify-content: flex-start; }.footer__brand { opacity: .4; transition: opacity .3s ease; }.footer__brand:hover { opacity: .7; }.footer__brand img { display: block; width: auto; height: 46px; max-width: 150px; object-fit: contain; }.footer__nav { margin: clamp(3rem,5vw,5rem) 0; }.footer__nav ul { display: flex; flex-wrap: wrap; gap: 16px 32px; margin: 0; padding: 0; list-style: none; }.footer__nav a { color: rgba(255,255,255,.22); font-size: 11px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; transition: color .2s ease; }.footer__nav a:hover { color: rgba(255,255,255,.6); }.footer__bottom { padding-top: 32px; border-top: 1px solid rgba(255,255,255,.06); color: rgba(255,255,255,.16); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; }.footer__bottom p { margin: 0; }@media(max-width:767px) { .footer__top,.footer__bottom { justify-content: center; text-align: center; }.footer__nav ul { display: grid; grid-template-columns: repeat(3,1fr); gap: 18px 8px; text-align: center; } }
	@media(prefers-reduced-motion:reduce) { .footer [data-footer-brand],.footer [data-footer-nav],.footer [data-footer-bottom] { opacity: 1 !important; transform: none !important; } }
</style>

<script>
	const footer = document.querySelector<HTMLElement>('[data-footer]');
	if (footer && !footer.dataset.ready && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		footer.dataset.ready = 'true'; const targets = [...footer.querySelectorAll<HTMLElement>('[data-footer-brand],[data-footer-nav],[data-footer-bottom]')]; const observer = new IntersectionObserver(([entry]) => { if (entry.isIntersecting) { targets.forEach((target, index) => { target.style.transition = `opacity .5s ${(.1 + index * .05)}s var(--ease-out-expo),transform .5s ${(.1 + index * .05)}s var(--ease-out-expo)`; target.style.opacity = '1'; target.style.transform = 'none'; }); observer.disconnect(); } }, { threshold: .12 }); targets.forEach((target) => { target.style.opacity = '0'; target.style.transform = 'translateY(10px)'; }); observer.observe(footer);
	}
</script>
