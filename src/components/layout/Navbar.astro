---
import Logo from '../ui/Logo.astro';
import { home } from '../../data/home';
import { navigation } from '../../data/site';
---

<header class="site-nav" data-navbar>
	<nav class="site-nav__desktop" aria-label="Navegación principal">
		<div class="site-nav__brand"><Logo /></div>
		<ul>{navigation.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
		<a class="site-nav__cta" href={home.links.contact} target="_blank" rel="noopener noreferrer">
			Hablemos <span aria-hidden="true">↗</span>
		</a>
	</nav>

	<div class="site-nav__mobile">
		<div class="site-nav__mobile-brand"><Logo /></div>
		<button type="button" class="site-nav__toggle" aria-expanded="false" aria-controls="mobile-menu">
			<span class="sr-only">Abrir menú</span><i></i><i></i>
		</button>
	</div>

	<div class="site-nav__menu" id="mobile-menu" aria-hidden="true">
		<p>Menú</p>
		<ul>{navigation.map((link, index) => <li><a href={link.href}><small>0{index + 1}</small>{link.label}<b>↗</b></a></li>)}</ul>
		<a class="site-nav__menu-cta" href={home.links.contact} target="_blank" rel="noopener noreferrer">Conversemos <span>↗</span></a>
	</div>
</header>

<style>
	.site-nav { position: fixed; z-index: 100; top: 18px; right: 0; left: 0; padding-inline: clamp(14px,2vw,28px); pointer-events: none; }
	.site-nav a,.site-nav button { pointer-events: auto; }
	.site-nav__desktop { display: grid; width: min(1360px,100%); min-height: 68px; margin: auto; padding: 8px 9px 8px 22px; align-items: center; grid-template-columns: 205px minmax(0,1fr) 205px; border: 1px solid rgba(255,255,255,.11); border-radius: 20px; background: rgba(2,9,16,.78); box-shadow: 0 18px 60px rgba(0,0,0,.28),inset 0 1px 0 rgba(255,255,255,.05); backdrop-filter: blur(22px); transition: background .25s ease,border-color .25s ease,transform .25s ease; }
	.site-nav.is-scrolled .site-nav__desktop { border-color: rgba(8,189,242,.2); background: rgba(2,9,16,.92); transform: translateY(-4px); }
	.site-nav__brand { display: flex; align-items: center; }
	.site-nav__desktop ul { display: flex; gap: 4px; margin: 0; padding: 0; align-items: center; justify-content: center; list-style: none; }
	.site-nav__desktop li a { display: block; padding: 10px 13px; border-radius: 999px; color: rgba(247,252,255,.72); font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; transition: color .2s ease,background .2s ease; white-space: nowrap; }
	.site-nav__desktop li a:hover { background: rgba(8,189,242,.1); color: var(--color-brand); }
	.site-nav__cta { display: inline-flex; min-height: 50px; gap: 16px; padding: 0 9px 0 20px; align-items: center; justify-self: end; border-radius: 14px; background: var(--color-brand); color: var(--color-night); font-size: .75rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; transition: background .2s ease,transform .2s ease,box-shadow .2s ease; }
	.site-nav__cta span { display: grid; width: 32px; height: 32px; place-items: center; border-radius: 9px; background: rgba(2,9,16,.12); font-size: 1rem; }
	.site-nav__cta:hover { background: #6cddff; box-shadow: 0 10px 30px rgba(var(--color-brand-rgb),.24); transform: translateY(-1px); }
	.site-nav__mobile,.site-nav__menu { display: none; }

	@media(max-width:940px) {
		.site-nav__desktop { grid-template-columns: 180px minmax(0,1fr) 170px; }
		.site-nav__desktop li a { padding-inline: 8px; font-size: .62rem; }
	}
	@media(max-width:767px) {
		.site-nav { top: 12px; padding-inline: 12px; }
		.site-nav__desktop { display: none; }
		.site-nav__mobile { display: flex; min-height: 62px; padding: 7px 8px 7px 16px; align-items: center; justify-content: space-between; border: 1px solid rgba(255,255,255,.11); border-radius: 18px; background: rgba(2,9,16,.9); box-shadow: 0 14px 40px rgba(0,0,0,.3); backdrop-filter: blur(22px); }
		.site-nav__mobile-brand { transform: scale(.9); transform-origin: left center; }
		.site-nav__toggle { display: grid; width: 48px; height: 48px; padding: 0; place-content: center; border: 1px solid rgba(8,189,242,.24); border-radius: 13px; background: rgba(8,189,242,.08); cursor: pointer; }
		.site-nav__toggle i { display: block; width: 20px; height: 1px; margin: 3px 0; background: var(--color-white); transition: transform .25s ease; }
		.site-nav.menu-open .site-nav__toggle i:first-of-type { transform: translateY(3.5px) rotate(45deg); }
		.site-nav.menu-open .site-nav__toggle i:last-of-type { transform: translateY(-3.5px) rotate(-45deg); }
		.site-nav__menu { position: fixed; inset: 0; z-index: -1; display: block; min-height: 100svh; padding: 7.5rem 20px 2rem; background: rgba(2,9,16,.98); color: var(--color-white); clip-path: inset(0 0 100% 0); pointer-events: none; transition: clip-path .45s var(--ease-out-expo); }
		.site-nav.menu-open .site-nav__menu { clip-path: inset(0); pointer-events: auto; }
		.site-nav__menu > p { margin: 0 0 1rem; color: var(--color-brand); font-size: .68rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
		.site-nav__menu ul { margin: 0; padding: 0; list-style: none; }
		.site-nav__menu li { border-bottom: 1px solid rgba(255,255,255,.1); }
		.site-nav__menu li a { display: grid; padding: 17px 0; align-items: center; grid-template-columns: 34px 1fr auto; color: #fff; font-size: clamp(2rem,10vw,3.5rem); font-weight: 700; letter-spacing: -.055em; }
		.site-nav__menu li small { color: var(--color-brand); font-size: .65rem; letter-spacing: .08em; }
		.site-nav__menu li b { color: var(--color-brand); font-size: .9rem; }
		.site-nav__menu-cta { display: flex; min-height: 56px; margin-top: 28px; padding: 0 18px; align-items: center; justify-content: space-between; border-radius: 14px; background: var(--color-brand); color: var(--color-night); font-size: .78rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
	}
</style>

<script>
	import { gsap } from 'gsap';

	const navbar = document.querySelector<HTMLElement>('[data-navbar]');
	if (navbar && !navbar.dataset.ready) {
		navbar.dataset.ready = 'true';
		const desktop = navbar.querySelector<HTMLElement>('.site-nav__desktop');
		const toggle = navbar.querySelector<HTMLButtonElement>('.site-nav__toggle');
		const menu = navbar.querySelector<HTMLElement>('.site-nav__menu');
		const setMenu = (open: boolean) => {
			navbar.classList.toggle('menu-open', open);
			toggle?.setAttribute('aria-expanded', String(open));
			menu?.setAttribute('aria-hidden', String(!open));
			document.body.classList.toggle('menu-open', open);
		};
		const updateNav = () => {
			const scrolled = window.scrollY > 48;
			navbar.classList.toggle('is-scrolled', scrolled);
			if (desktop && window.innerWidth >= 768) {
				gsap.to(desktop, { width: scrolled ? Math.min(1220, window.innerWidth - 48) : Math.min(1360, window.innerWidth - 48), duration: .48, ease: 'power3.out', overwrite: true });
			}
		};
		toggle?.addEventListener('click', () => setMenu(!navbar.classList.contains('menu-open')));
		menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
		const onKeydown = (event: KeyboardEvent) => { if (event.key === 'Escape') setMenu(false); };
		const onAnchorClick = (event: MouseEvent) => {
			const anchor = event.currentTarget as HTMLAnchorElement;
			const hash = new URL(anchor.href).hash;
			const target = hash && document.querySelector<HTMLElement>(hash);
			if (!target || !window.__pulsoLenis) return;
			event.preventDefault();
			window.history.pushState(null, '', hash);
			window.__pulsoLenis.scrollTo(target, { duration: .72, offset: -86 });
		};
		const anchors = [...navbar.querySelectorAll<HTMLAnchorElement>('a[href*="#"]')];
		anchors.forEach((anchor) => anchor.addEventListener('click', onAnchorClick));
		window.addEventListener('scroll', updateNav, { passive: true });
		window.addEventListener('resize', updateNav);
		document.addEventListener('keydown', onKeydown);
		updateNav();
		window.addEventListener('pagehide', () => {
			window.removeEventListener('scroll', updateNav);
			window.removeEventListener('resize', updateNav);
			document.removeEventListener('keydown', onKeydown);
			anchors.forEach((anchor) => anchor.removeEventListener('click', onAnchorClick));
			gsap.killTweensOf(desktop);
		}, { once: true });
	}
</script>
