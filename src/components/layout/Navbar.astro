---
import { home } from '../../data/home';
import { navigation } from '../../data/site';

const links = navigation;
---

<header class="editorial-nav" data-navbar>
	<nav class="editorial-nav__desktop" aria-label="Navegación principal">
		<a class="editorial-nav__logo" href="/#home" aria-label="PulsoWeb, inicio"><img src={home.assets.logo} alt="PulsoWeb" width="150" height="46" /></a>
		<ul>{links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
		<a class="editorial-nav__cta" href={home.links.contact} target="_blank" rel="noopener noreferrer">CONTACTAR <b>↗</b></a>
	</nav>
	<div class="editorial-nav__mobile">
		<a class="editorial-nav__logo editorial-nav__mobile-pill" href="/#home" aria-label="PulsoWeb, inicio"><img src={home.assets.logo} alt="PulsoWeb" width="150" height="46" /></a>
		<button type="button" class="editorial-nav__toggle editorial-nav__mobile-pill" aria-expanded="false" aria-controls="mobile-menu"><span class="sr-only">Abrir menú</span><i></i><i></i></button>
	</div>
	<div class="editorial-nav__menu" id="mobile-menu" aria-hidden="true">
		<button type="button" class="editorial-nav__close" aria-label="Cerrar menú">×</button>
		<ul>{links.map((link) => <li><a href={link.href}>{link.label}<b>↗</b></a></li>)}</ul>
		<a class="editorial-nav__menu-cta" href={home.links.contact} target="_blank" rel="noopener noreferrer">CONTACTAR</a>
	</div>
</header>

<style>
	.editorial-nav { position: fixed; z-index: 100; top: 16px; right: 0; left: 0; pointer-events: none; }
	.editorial-nav a,.editorial-nav button { pointer-events: auto; }
	.editorial-nav__desktop { display: flex; width: min(920px,calc(100vw - 40px)); min-height: 58px; margin: auto; padding: 6px 10px 6px 14px; align-items: center; border: 1px solid rgba(255,255,255,.08); border-radius: 999px; background: rgba(10,10,10,.95); box-shadow: 0 8px 40px rgba(0,0,0,.5),inset 0 1px 0 rgba(255,255,255,.08); backdrop-filter: blur(28px); color: #d9d9d9; transition: background .25s ease,backdrop-filter .25s ease,box-shadow .25s ease; }
	.editorial-nav.is-scrolled .editorial-nav__desktop { border-color: rgba(255,255,255,.1); background: rgba(10,10,10,.75); box-shadow: 0 5px 24px rgba(0,0,0,.3); backdrop-filter: blur(16px); }
	.editorial-nav__logo { display: flex; flex: 0 0 auto; align-items: center; }
	.editorial-nav__logo img { display: block; width: auto; height: 46px; max-width: 150px; object-fit: contain; }
	.editorial-nav__desktop ul { position: absolute; left: 50%; display: flex; gap: 4px; margin: 0; padding: 0; list-style: none; transform: translateX(-50%); }
	.editorial-nav__desktop li a { display: block; padding: 9px 11px; border-radius: 999px; color: #d9d9d9; font-size: 10px; font-weight: 600; letter-spacing: .15em; text-transform: uppercase; transition: background .2s ease; white-space: nowrap; }
	.editorial-nav__desktop li a:hover { background: rgba(255,255,255,.08); }
	.editorial-nav__cta { display: inline-flex; gap: 10px; min-height: 42px; margin-left: auto; padding: 0 7px 0 15px; align-items: center; border-radius: 999px; background: #fff; color: #0a0a0a; font-size: 10px; font-weight: 700; letter-spacing: .13em; }
	.editorial-nav__cta b { display: grid; width: 30px; height: 30px; place-items: center; border-radius: 50%; background: rgba(10,10,10,.1); font-size: 14px; }
	.editorial-nav__mobile,.editorial-nav__menu { display: none; }
	@media(max-width:767px) {
		.editorial-nav { top: 16px; }
		.editorial-nav__desktop { display: none; }
		.editorial-nav__mobile { display: flex; padding: 0 16px; justify-content: space-between; }
		.editorial-nav__mobile-pill { display: grid; height: 58px; padding: 6px 12px; place-items: center; border: 1px solid rgba(255,255,255,.08); border-radius: 999px; background: rgba(10,10,10,.95); box-shadow: 0 8px 40px rgba(0,0,0,.5),inset 0 1px 0 rgba(255,255,255,.08); backdrop-filter: blur(28px); }
		.editorial-nav__mobile .editorial-nav__logo { padding: 6px 14px; }
		.editorial-nav__toggle { width: 58px; cursor: pointer; }
		.editorial-nav__toggle i { display: block; width: 21px; height: 1px; margin: 4px; background: #fff; transition: transform .25s ease; }
		.editorial-nav.menu-open .editorial-nav__toggle i:first-of-type { transform: translateY(4.5px) rotate(45deg); }
		.editorial-nav.menu-open .editorial-nav__toggle i:last-of-type { transform: translateY(-4.5px) rotate(-45deg); }
		.editorial-nav__menu { position: fixed; inset: -16px 0 0; z-index: -1; min-height: 100svh; padding: 8rem 24px 2rem; background: rgba(10,10,10,.95); backdrop-filter: blur(28px); clip-path: inset(0 0 100% 0); pointer-events: none; transition: clip-path .4s var(--ease-out-expo); }
		.editorial-nav.menu-open .editorial-nav__menu { clip-path: inset(0 0 0 0); pointer-events: auto; }
		.editorial-nav__menu ul { margin: 0; padding: 0; list-style: none; }
		.editorial-nav__menu li { border-bottom: 1px solid rgba(255,255,255,.12); opacity: 0; transform: translateY(16px); }
		.editorial-nav.menu-open .editorial-nav__menu li { opacity: 1; transform: none; transition: opacity .35s var(--ease-out-expo),transform .35s var(--ease-out-expo); }
		.editorial-nav.menu-open .editorial-nav__menu li:nth-child(2) { transition-delay: .06s; }.editorial-nav.menu-open .editorial-nav__menu li:nth-child(3) { transition-delay: .12s; }
		.editorial-nav__menu li a { display: flex; padding: 20px 0; justify-content: space-between; color: #fff; font-size: clamp(2.2rem,10vw,4rem); font-weight: 900; letter-spacing: -.06em; }
		.editorial-nav__menu li b { font-size: .5em; font-weight: 400; }
		.editorial-nav__close { position: absolute; top: 20px; right: 20px; width: 48px; height: 48px; border: 1px solid rgba(255,255,255,.2); border-radius: 50%; background: transparent; color: #fff; font-size: 32px; cursor: pointer; }
		.editorial-nav__menu-cta { display: inline-flex; margin-top: 40px; padding: 14px 18px; border-radius: 999px; background: #fff; color: #0a0a0a; font-size: 10px; font-weight: 700; letter-spacing: .15em; }
	}
</style>

<script>
	import { gsap } from 'gsap';

	const navbar = document.querySelector<HTMLElement>('[data-navbar]');
	if (navbar && !navbar.dataset.ready) {
		navbar.dataset.ready = 'true';
		const desktop = navbar.querySelector<HTMLElement>('.editorial-nav__desktop');
		const toggle = navbar.querySelector<HTMLButtonElement>('.editorial-nav__toggle');
		const menu = navbar.querySelector<HTMLElement>('.editorial-nav__menu');
		const close = navbar.querySelector<HTMLButtonElement>('.editorial-nav__close');
		const setMenu = (open: boolean) => { navbar.classList.toggle('menu-open', open); toggle?.setAttribute('aria-expanded', String(open)); menu?.setAttribute('aria-hidden', String(!open)); document.body.classList.toggle('menu-open', open); };
		const updateNav = () => {
			const scrolled = window.scrollY > 60; navbar.classList.toggle('is-scrolled', scrolled);
			if (desktop && window.innerWidth >= 768) gsap.to(desktop, { width: scrolled ? Math.min(window.innerWidth - 2 * Math.min(Math.max(window.innerWidth * .04, 20), 80), 980) : Math.min(920, window.innerWidth - 40), duration: .65, ease: 'elastic.out(1, .7)', overwrite: 'auto' });
		};
		toggle?.addEventListener('click', () => setMenu(!navbar.classList.contains('menu-open'))); close?.addEventListener('click', () => setMenu(false)); menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
		const onKeydown = (event: KeyboardEvent) => { if (event.key === 'Escape') setMenu(false); };
		const onAnchorClick = (event: MouseEvent) => {
			const anchor = (event.currentTarget as HTMLAnchorElement); const hash = new URL(anchor.href).hash; const target = hash && document.querySelector<HTMLElement>(hash);
			if (!target || !window.__pulsoLenis) return;
			event.preventDefault(); window.history.pushState(null, '', hash); window.__pulsoLenis.scrollTo(target, { duration: 1.6, easing: (value: number) => value < .5 ? 2 * value * value : 1 - Math.pow(-2 * value + 2, 2) / 2 });
		};
		const anchors = [...navbar.querySelectorAll<HTMLAnchorElement>('a[href*="#"]')]; anchors.forEach((anchor) => anchor.addEventListener('click', onAnchorClick));
		window.addEventListener('scroll', updateNav, { passive: true }); window.addEventListener('resize', updateNav); document.addEventListener('keydown', onKeydown); updateNav();
		window.addEventListener('pagehide', () => { window.removeEventListener('scroll', updateNav); window.removeEventListener('resize', updateNav); document.removeEventListener('keydown', onKeydown); anchors.forEach((anchor) => anchor.removeEventListener('click', onAnchorClick)); gsap.killTweensOf(desktop); }, { once: true });
	}
</script>
