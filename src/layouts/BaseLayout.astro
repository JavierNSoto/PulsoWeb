---
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppButton from '../components/layout/WhatsAppButton.astro';
import MotionEffects from '../components/layout/MotionEffects.astro';
import { contactEmail, whatsappDisplay } from '../data/site';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = 'Diseño de páginas web y ecommerce en Chile | PulsoWeb',
	description = 'Diseñamos páginas web y ecommerce rápidos, profesionales y preparados para hacer crecer negocios en Chile.',
	image = '/images/hero-desarrollo-web.webp',
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://pulsoweb.cl');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const socialImageUrl = new URL(image, siteUrl);
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: 'PulsoWeb',
	description,
	url: siteUrl.toString(),
	image: socialImageUrl.toString(),
	email: contactEmail,
	telephone: whatsappDisplay,
	areaServed: { '@type': 'Country', name: 'Chile' },
	serviceType: ['Diseño de páginas web', 'Desarrollo ecommerce', 'Mantención web', 'Seguridad web'],
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" content="#FFFFFF" />
		<link rel="icon" type="image/png" href="/images/logo-pulsoweb-symbol.png" />
		<link rel="apple-touch-icon" href="/images/logo-pulsoweb-symbol.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_CL" />
		<meta property="og:site_name" content="PulsoWeb" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:alt" content="PulsoWeb, diseño y desarrollo web en Chile" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageUrl} />
		<title>{title}</title>
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body>
		<Navbar />
		<slot />
		<Footer />
		<WhatsAppButton />
		<MotionEffects />
		<script>
			import Lenis from 'lenis';
			import { gsap } from 'gsap';
			import { ScrollTrigger } from 'gsap/ScrollTrigger';

			gsap.registerPlugin(ScrollTrigger);
			const canSmoothScroll = window.matchMedia('(min-width: 768px) and (prefers-reduced-motion: no-preference)').matches;
			const smoothWindow = window as typeof window & { __pulsoLenis?: Lenis };
			if (canSmoothScroll && !smoothWindow.__pulsoLenis) {
				const lenis = new Lenis({ duration: 1.3, easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)) });
				const onScroll = () => ScrollTrigger.update();
				const onTick = (time: number) => lenis.raf(time * 1000);
				lenis.on('scroll', onScroll);
				gsap.ticker.add(onTick);
				gsap.ticker.lagSmoothing(0);
				smoothWindow.__pulsoLenis = lenis;
				window.addEventListener('pagehide', () => { lenis.off('scroll', onScroll); lenis.destroy(); gsap.ticker.remove(onTick); ScrollTrigger.getAll().forEach((trigger) => trigger.kill()); delete smoothWindow.__pulsoLenis; }, { once: true });
			}
		</script>
	</body>
</html>
